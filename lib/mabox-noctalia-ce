#!/usr/bin/env bash
cfg="$HOME/.config/mabox-noctalia-ce"
mkdir -p "$HOME/.config"
[[ -d $cfg ]] || cp -rn /etc/skel/.config/mabox-noctalia-ce "$HOME/.config/"
cp -rn /usr/share/mabox-noctalia-ce/noctalia "$HOME/.config/"
mkdir -p "$HOME/.local/share/themes/noctalia/openbox-3"
conf="$HOME/.config/qt6ct/qt6ct.conf"
[[ -e $conf ]] || { mkdir -p "${conf%/*}"; printf '[Appearance]\ncolor_scheme_path=%s/.config/qt6ct/colors/noctalia.conf\ncustom_palette=true\nstyle=Fusion\n' "$HOME" > "$conf"; }
export PATH="$HOME/bin:$PATH"
export QT_QPA_PLATFORMTHEME=qt6ct
exec labwc -C "$cfg"
