#!/usr/bin/env bash
cfg="$HOME/.config/mabox-noctalia-ce"
mkdir -p "$HOME/.config"
[[ -d $cfg ]] || cp -rn /etc/skel/.config/mabox-noctalia-ce "$HOME/.config/"
cp -rn /usr/share/mabox-noctalia-ce/noctalia "$HOME/.config/"
mkdir -p "$HOME/.local/share/themes/noctalia/openbox-3"
export PATH="$HOME/bin:$PATH"
exec labwc -C "$cfg"
