def category(cid):
    title, items = CATEGORIES[cid]
    parts = []
    for tool, label, cmd in items:
        if tool and shutil.which(tool) is None:
            parts.append(section(label, f"({tool} not installed)"))
        else:
            parts.append(section(label, run(["sh", "-c", cmd], 60)))
    return section(title, "") + "\n".join(parts)


def build(cmd):
    if cmd == "overview":
        return overview()
    if cmd == "hardware":
        return hardware()
    if cmd == "logs":
        return logs()
    if cmd in CATEGORIES:
        return category(cmd)
    if cmd in LOG_PARTS:
        return LOG_PARTS[cmd]()
    return overview() + "\n" + hardware() + "\n" + logs()


def write_report(text, raw, save_dir):
    if save_dir and not os.path.isdir(save_dir):
        sys.exit(f"{save_dir} is not a folder")
    docs = save_dir
    if not docs:
        docs = run(["xdg-user-dir", "DOCUMENTS"])
        if docs.startswith("(") or not os.path.isdir(docs):
            docs = HOME
    path = os.path.join(docs, f"mabox-report{'-private' if raw else ''}-{datetime.datetime.now():%Y%m%d-%H%M}.txt")
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
    except OSError as e:
        sys.exit(f"cannot write {path}: {e}")
    return path


def main():
    args = sys.argv[1:]
    save = "--save" in args
    raw = "--raw" in args
    hide = []
    if "--hide" in args:
        k = args.index("--hide")
        hide = [w.strip() for w in (args[k + 1] if k + 1 < len(args) else "").split(",") if len(w.strip()) >= 2]
        del args[k:k + 2]
    save_dir = ""
    if "--dir" in args:
        k = args.index("--dir")
        save_dir = os.path.expanduser(args[k + 1]) if k + 1 < len(args) else ""
        del args[k:k + 2]
    parts = []
    if "--parts" in args:
        k = args.index("--parts")
        parts = [p for p in (args[k + 1] if k + 1 < len(args) else "").split(",") if p]
        del args[k:k + 2]
        bad = [p for p in parts if p not in ("overview", "hardware", *LOG_PARTS, *CATEGORIES)]
        if bad:
            sys.exit(f"unknown part: {bad[0]}")
    args = [a for a in args if a not in ("--save", "--raw")]
    if args == ["scrub"]:
        data = sys.stdin.read()
        print(data if raw else scrub(data, hide)[0], end="")
        return
    if len(args) == 2 and args[0] == "put":
        # Writes the text the panel shows (a temp file it made), so the saved file is what was read.
        with open(args[1], errors="replace") as f:
            text = f.read()
        os.remove(args[1])
        print(write_report(text, raw, save_dir))
        return
    if len(args) != 1 or args[0] not in ("overview", "hardware", "logs", "report", *CATEGORIES):
        sys.exit(__doc__.strip())
    cmd = args[0]
    full = cmd == "report" or cmd in CATEGORIES
    body = "\n".join(build(p) for p in parts) if parts and cmd == "report" else build(cmd)
    text, hits = (body, {}) if raw else scrub(body, hide)
    if full:
        removed = ", ".join(f"{k} {n}" for k, n in sorted(hits.items())) or "nothing found"
        ver = run(["pacman", "-Q", "mabox-noctalia-ce"])
        note = ("PRIVATE copy, nothing removed. Do not post it." if raw
                else f"Removed: {sum(hits.values())} items ({removed}). Read before posting.")
        head = (f"Mabox Noctalia CE report, {datetime.datetime.now():%Y-%m-%d %H:%M}\n"
                f"{ver}\n{note}\n"
                + (f"Included: {', '.join(parts)}\n" if parts and cmd == "report" else "") + "\n")
        text = (head if raw else scrub(head, hide)[0]) + text
    if save and full:
        print(write_report(text, raw, save_dir))
    else:
        print(text)


if __name__ == "__main__":
    main()
