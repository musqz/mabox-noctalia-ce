#!/usr/bin/env python3
"""mb-sysreport - system info with personal data removed, for the mabox/system plugin.

  mb-sysreport overview|hardware|logs|report [--save]

Prints sanitized text. --save (report only) writes mabox-report-YYYYMMDD-HHMM.txt
to the Documents folder and prints the path.
"""
import collections
import datetime
import getpass
import os
import pwd
import re
import shutil
import subprocess
import sys

HOME = os.environ.get("HOME", "")


def run(cmd, timeout=20):
    if shutil.which(cmd[0]) is None:
        return f"({cmd[0]} not installed)"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as e:
        return f"({cmd[0]} failed: {e})"
    out = (r.stdout or "").strip()
    if not out and r.stderr.strip():
        out = r.stderr.strip()
    return out or f"({cmd[0]}: no output)"


def read_tail(path, n, pattern=None):
    try:
        with open(path, errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return f"({path} not readable)"
    if pattern:
        lines = [l for l in lines if re.search(pattern, l)]
    return "\n".join(lines[-n:]) or "(empty)"


def section(title, body):
    return f"== {title} ==\n{body}\n"


# --- sanitizer ---------------------------------------------------------

COMMON = {"root", "user", "admin", "arch", "manjaro", "mabox", "localhost", "linux"}


def known_names():
    names = {"user": set(), "host": set(), "wifi": set()}
    names["user"].add(getpass.getuser())
    try:
        pw = pwd.getpwuid(os.getuid())
        names["user"].add(pw.pw_name)
        real = pw.pw_gecos.split(",")[0].strip()
        if real:
            names["user"].add(real)
    except KeyError:
        pass
    for h in (run(["hostname"]), read_tail("/etc/hostname", 1)):
        if h and not h.startswith("("):
            names["host"].add(h.strip())
    out = run(["hostnamectl", "hostname"])
    if out and not out.startswith("("):
        names["host"].add(out.strip())
    out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
    for l in out.splitlines():
        name, _, typ = l.rpartition(":")
        if typ == "802-11-wireless":
            names["wifi"].add(name.replace("\\:", ":"))
    out = run(["nmcli", "-t", "-f", "SSID", "device", "wifi"])
    if not out.startswith(("(", "Error")):
        names["wifi"].update(l.strip() for l in out.splitlines())
    names["wifi"].discard("--")
    names["user"] -= COMMON
    names["host"] -= COMMON
    return {k: sorted({n for n in v if len(n) >= 2}, key=len, reverse=True)
            for k, v in names.items()}


def scrub(text):
    hits = collections.Counter()

    def sub(pattern, repl, kind, flags=0):
        nonlocal text

        def f(m):
            hits[kind] += 1
            return m.expand(repl) if isinstance(repl, str) else repl(m)
        text = re.sub(pattern, f, text, flags=flags)

    if HOME:
        text = text.replace(HOME, "~")

    names = known_names()
    for kind, label in (("user", "<user>"), ("host", "<host>"), ("wifi", "<wifi>")):
        for n in names[kind]:
            sub(r"(?<![A-Za-z0-9])" + re.escape(n) + r"(?![A-Za-z0-9])", label, kind, re.I)

    sub(r"(\w+://)[^/\s:@]+:[^/\s@]+@", r"\1<cred>@", "url-cred")
    sub(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+", "<email>", "email")
    sub(r"""(?i)\b(ssid)(\s*[:=]?\s*)(?:"[^"]*"|'[^']*'|[^\s"']+)""", r"\1\2<wifi>", "wifi")
    sub(r"(?i)\b(token|secret|password|passwd|api[_-]?key)(\s*[:=]\s*)\S+", r"\1\2<secret>", "token")
    sub(r"(?i)\b(serial(?: number)?|s/n)(\s*[:=]\s*)\S+", r"\1\2<serial>", "serial")
    sub(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", "<uuid>", "uuid", re.I)
    sub(r"(?<![0-9a-f:-])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f:-])", "<mac>", "mac", re.I)
    sub(r"\b0x[0-9a-f]{8}\b", "<id>", "serial", re.I)
    sub(r"(?<![0-9a-f])[0-9a-f]{32,}(?![0-9a-f])", "<id>", "machine-id", re.I)

    def ipv4(m):
        ip = m.group(0)
        if ip.startswith("127.") or ip == "0.0.0.0" or any(int(p) > 255 for p in ip.split(".")):
            return ip
        hits["ip"] += 1
        return "<ip>"
    text = re.sub(r"(?<![\d.])(?<!v: )(?:\d{1,3}\.){3}\d{1,3}(?![\d.]|-\d)", ipv4, text)

    def ipv6(m):
        ip = m.group(0)
        if ip in ("::", "::1"):
            return ip
        hits["ip"] += 1
        return "<ip>"
    h = r"[0-9a-f]{1,4}"
    text = re.sub(
        r"(?<![0-9A-Za-z:])(?:(?:" + h + r":){7}" + h + r"|(?:" + h + r":){1,7}:(?:" + h + r"(?::" + h + r"){0,6})?|::" + h + r"(?::" + h + r"){0,6})(?![0-9A-Za-z:])",
        ipv6, text, flags=re.I)

    def token(m):
        t = m.group(0)
        if re.search(r"\d", t) and re.search(r"[a-z]", t) and re.search(r"[A-Z]", t):
            hits["token"] += 1
            return "<token>"
        return t
    text = re.sub(r"[A-Za-z0-9_-]{32,}", token, text)

    return text, hits


# --- collectors --------------------------------------------------------

def install_date():
    try:
        t = int(run(["stat", "-c", "%W", "/"]))
    except ValueError:
        return "unknown"
    return datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d")


def outputs():
    out = run(["wlr-randr"])
    if out.startswith("("):
        return out
    rows, cur = [], None
    for line in out.splitlines():
        if line and not line[0].isspace():
            cur = {"name": line.split()[0], "mode": "", "scale": "", "on": ""}
            rows.append(cur)
        elif cur is not None:
            s = line.strip()
            if s.startswith("Enabled:"):
                cur["on"] = s.split(":", 1)[1].strip()
            elif s.startswith("Scale:"):
                cur["scale"] = s.split(":", 1)[1].strip()
            elif "current" in s:
                cur["mode"] = s.split(" (")[0]
    return "\n".join(f"{r['name']}  {r['mode']}  scale {r['scale']}  enabled {r['on']}" for r in rows)


def overview():
    pk = run(["pacman", "-Qq"])
    count = len(pk.splitlines()) if not pk.startswith("(") else pk
    lines = [
        run(["lsb_release", "-ds"]),
        f"Kernel:        {run(['uname', '-r'])}",
        f"Uptime:        {run(['uptime', '-p'])}",
        f"Installed:     {install_date()}",
        f"Packages:      {count}",
        f"Labwc:         {run(['labwc', '-v'])}",
        f"Noctalia:      {run(['noctalia', '--version'])}",
        f"Session:       {os.environ.get('XDG_SESSION_DESKTOP', '-')} ({os.environ.get('WAYLAND_DISPLAY', '-')})",
        "",
        run(["pacman", "-Q", "mabox-noctalia-ce", "noctalia", "labwc"]),
        "",
        "Outputs:",
        outputs(),
    ]
    return section("Overview", "\n".join(lines))


def hardware():
    if shutil.which("inxi"):
        body = run(["inxi", "-c", "0", "-Fxxz"], 60)
    else:
        body = "\n\n".join([
            run(["lscpu"]), run(["lspci", "-k"]), run(["free", "-h"]),
            run(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT"]),
        ])
    return section("Hardware", body)


def logs():
    return "\n".join([
        section("Journal, system (warnings, this boot)",
                run(["journalctl", "-b", "-p", "warning", "--no-pager", "-n", "300"], 30)),
        section("Journal, user (warnings, this boot)",
                run(["journalctl", "--user", "-b", "-p", "warning", "--no-pager", "-n", "150"], 30)),
        section("Noctalia log", read_tail(os.path.join(HOME, ".cache", "noctalia", "noctalia.log"), 200)),
        section("Pacman log (last 30 changes)",
                read_tail("/var/log/pacman.log", 30, r"\] \[ALPM\] (upgraded|installed|removed)")),
    ])


def build(cmd):
    if cmd == "overview":
        return overview()
    if cmd == "hardware":
        return hardware()
    if cmd == "logs":
        return logs()
    return overview() + "\n" + hardware() + "\n" + logs()


def main():
    args = sys.argv[1:]
    save = "--save" in args
    args = [a for a in args if a != "--save"]
    if len(args) != 1 or args[0] not in ("overview", "hardware", "logs", "report"):
        sys.exit(__doc__.strip())
    cmd = args[0]
    text, hits = scrub(build(cmd))
    if cmd == "report":
        removed = ", ".join(f"{k} {n}" for k, n in sorted(hits.items())) or "nothing found"
        ver = run(["pacman", "-Q", "mabox-noctalia-ce"])
        head = (f"Mabox Noctalia CE report, {datetime.datetime.now():%Y-%m-%d %H:%M}\n"
                f"{ver}\n"
                f"Removed: {sum(hits.values())} items ({removed}). Read before posting.\n\n")
        text = head + text
    if save and cmd == "report":
        docs = run(["xdg-user-dir", "DOCUMENTS"])
        if docs.startswith("(") or not os.path.isdir(docs):
            docs = HOME
        path = os.path.join(docs, f"mabox-report-{datetime.datetime.now():%Y%m%d-%H%M}.txt")
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(text)
        except OSError as e:
            sys.exit(f"cannot write {path}: {e}")
        print(path)
    else:
        print(text)


if __name__ == "__main__":
    main()
