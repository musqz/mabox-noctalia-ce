#!/usr/bin/env python3
"""mb-sysreport - system info with personal data removed, for the mabox/system plugin.

  mb-sysreport overview|hardware|logs|report|<category> [--parts A,B,...] [--save [--dir DIR]] [--raw] [--hide WORDS]
  mb-sysreport scrub [--hide WORDS]   sanitize stdin
  mb-sysreport put FILE [--raw] [--dir DIR]   save a report text, then delete FILE

--raw keeps everything (private copy, never share it). --hide takes
comma-separated words that are replaced by <hidden>.

--parts (report only) picks what the report holds: overview, hardware,
log-system, log-user, log-prev, log-kernel, log-failed, log-crashes,
log-noctalia, log-pacman and the categories below. Without it: overview,
hardware and all logs.

Categories: full, hardware-only, audio, graphics, network, bluetooth, disks,
boot, packages, power, desktop. Prints sanitized text. --save (report and
categories) writes mabox-report-YYYYMMDD-HHMM.txt to the Documents folder
and prints the path.
"""
import collections
import datetime
import getpass
import os
import pwd
import re
import shutil
import subprocess
import sys

HOME = os.environ.get("HOME", "")


def run(cmd, timeout=20):
    if shutil.which(cmd[0]) is None:
        return f"({cmd[0]} not installed)"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as e:
        return f"({cmd[0]} failed: {e})"
    out = (r.stdout or "").strip()
    if not out and r.stderr.strip():
        out = r.stderr.strip()
    return out or f"({cmd[0]}: no output)"


def read_tail(path, n, pattern=None):
    try:
        with open(path, errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return f"({path} not readable)"
    if pattern:
        lines = [l for l in lines if re.search(pattern, l)]
    return "\n".join(lines[-n:]) or "(empty)"


def section(title, body):
    return f"== {title} ==\n{body}\n"


# --- sanitizer ---------------------------------------------------------

UNIT_SUFFIXES = (".service", ".socket", ".timer", ".mount", ".automount", ".target",
                 ".path", ".slice", ".scope", ".device", ".swap")
COMMON = {"root", "user", "admin", "arch", "manjaro", "mabox", "localhost", "linux"}


def known_names():
    names = {"user": set(), "host": set(), "wifi": set()}
    names["user"].add(getpass.getuser())
    try:
        pw = pwd.getpwuid(os.getuid())
        names["user"].add(pw.pw_name)
        real = pw.pw_gecos.split(",")[0].strip()
        if real:
            names["user"].add(real)
    except KeyError:
        pass
    for h in (run(["hostname"]), read_tail("/etc/hostname", 1)):
        if h and not h.startswith("("):
            names["host"].add(h.strip())
    out = run(["hostnamectl", "hostname"])
    if out and not out.startswith("("):
        names["host"].add(out.strip())
    out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
    for l in out.splitlines():
        name, _, typ = l.rpartition(":")
        if typ == "802-11-wireless":
            names["wifi"].add(name.replace("\\:", ":"))
    names["wifi"].discard("--")
    names["user"] -= COMMON
    names["host"] -= COMMON
    return {k: sorted({n for n in v if len(n) >= 2}, key=len, reverse=True)
            for k, v in names.items()}


def scrub(text, hide=()):
    hits = collections.Counter()

    def sub(pattern, repl, kind, flags=0):
        nonlocal text

        def f(m):
            hits[kind] += 1
            return m.expand(repl) if isinstance(repl, str) else repl(m)
        text = re.sub(pattern, f, text, flags=flags)

    text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", text)
    if HOME:
        text = text.replace(HOME, "~")

    names = known_names()
    for kind, label in (("user", "<user>"), ("host", "<host>"), ("wifi", "<wifi>")):
        for n in names[kind]:
            sub(r"(?<![A-Za-z0-9])" + re.escape(n) + r"(?![A-Za-z0-9])", label, kind, re.I)

    sub(r"(\w+://)[^/\s:@]+:[^/\s@]+@", r"\1<cred>@", "url-cred")
    # name@instance.service is a systemd template unit, not an address.
    sub(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+",
        lambda m: m.group(0) if m.group(0).endswith(UNIT_SUFFIXES) else "<email>", "email")
    for w in sorted(hide, key=len, reverse=True):
        sub(r"(?<![A-Za-z0-9])" + re.escape(w) + r"(?![A-Za-z0-9])", "<hidden>", "hidden", re.I)
    sub(r"""(?i)\b(ssid)(\s*[:=]?\s*)(?:"[^"]*"|'[^']*'|[^\s"']+)""", r"\1\2<wifi>", "wifi")
    sub(r"(?i)\b(token|secret|password|passwd|api[_-]?key)(\s*[:=]\s*)\S+", r"\1\2<secret>", "token")
    sub(r"(?i)\b(serial(?: number)?|s/n)(\s*[:=]\s*)\S+", r"\1\2<serial>", "serial")
    sub(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", "<uuid>", "uuid", re.I)
    sub(r"(?<![0-9a-f:-])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f:-])", "<mac>", "mac", re.I)
    sub(r"(?<![\w-])[0-9A-F]{4}-[0-9A-F]{4}(?![\w-])", lambda m: "<id>" if re.search("[A-F]", m.group(0)) else m.group(0), "serial")
    sub(r"\b0x[0-9a-f]{8}\b", "<id>", "serial", re.I)
    sub(r"(?<![0-9a-f])[0-9a-f]{32,}(?![0-9a-f])", "<id>", "machine-id", re.I)

    def ipv4(m):
        ip = m.group(0)
        if ip.startswith("127.") or ip == "0.0.0.0" or any(int(p) > 255 for p in ip.split(".")):
            return ip
        hits["ip"] += 1
        return "<ip>"
    text = re.sub(r"(?<![\d.])(?<!v: )(?:\d{1,3}\.){3}\d{1,3}(?![\d.]|-\d)", ipv4, text)

    def ipv6(m):
        ip = m.group(0)
        if ip in ("::", "::1"):
            return ip
        hits["ip"] += 1
        return "<ip>"
    h = r"[0-9a-f]{1,4}"
    text = re.sub(
        r"(?<![0-9A-Za-z:])(?:(?:" + h + r":){7}" + h + r"|(?:" + h + r":){1,7}:(?:" + h + r"(?::" + h + r"){0,6})?|::" + h + r"(?::" + h + r"){0,6})(?![0-9A-Za-z:])",
        ipv6, text, flags=re.I)

    def token(m):
        t = m.group(0)
        if re.search(r"\d", t) and re.search(r"[a-z]", t) and re.search(r"[A-Z]", t):
            hits["token"] += 1
            return "<token>"
        return t
    text = re.sub(r"[A-Za-z0-9_-]{32,}", token, text)

    return text, hits


# --- collectors --------------------------------------------------------

def install_date():
    try:
        t = int(run(["stat", "-c", "%W", "/"]))
    except ValueError:
        return "unknown"
    if t <= 0:
        return "unknown"
    return datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d")


def outputs():
    out = run(["wlr-randr"])
    if out.startswith("("):
        return out
    rows, cur = [], None
    for line in out.splitlines():
        if line and not line[0].isspace():
            cur = {"name": line.split()[0], "mode": "", "scale": "", "on": ""}
            rows.append(cur)
        elif cur is not None:
            s = line.strip()
            if s.startswith("Enabled:"):
                cur["on"] = s.split(":", 1)[1].strip()
            elif s.startswith("Scale:"):
                cur["scale"] = s.split(":", 1)[1].strip()
            elif "current" in s:
                cur["mode"] = s.split(" (")[0]
    return "\n".join(f"{r['name']}  {r['mode']}  scale {r['scale']}  enabled {r['on']}" for r in rows)


def overview():
    pk = run(["pacman", "-Qq"])
    count = len(pk.splitlines()) if not pk.startswith("(") else pk
    lines = [
        run(["lsb_release", "-ds"]),
        f"Kernel:        {run(['uname', '-r'])}",
        f"Uptime:        {run(['uptime', '-p'])}",
        f"Installed:     {install_date()}",
        f"Packages:      {count}",
        f"Labwc:         {run(['labwc', '-v'])}",
        f"Noctalia:      {run(['noctalia', '--version'])}",
        f"Session:       {os.environ.get('XDG_SESSION_DESKTOP', '-')} ({os.environ.get('WAYLAND_DISPLAY', '-')})",
        "",
        run(["pacman", "-Q", "mabox-noctalia-ce", "noctalia", "labwc"]),
        "",
        "Outputs:",
        outputs(),
    ]
    return section("Overview", "\n".join(lines))


def hardware():
    if shutil.which("inxi"):
        body = run(["inxi", "-c", "0", "-Fxxz"], 60)
    else:
        body = "\n\n".join([
            run(["lscpu"]), run(["lspci", "-k"]), run(["free", "-h"]),
            run(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT"]),
        ])
    return section("Hardware", body)


FAILED_SERVICES = (
    "systemctl --failed --no-pager; systemctl --user --failed --no-pager; "
    "for u in $(systemctl --failed --plain --no-legend | awk '{print $1}'); do "
    "echo \"## $u\"; journalctl -b -u \"$u\" -n 15 --no-pager; done"
)


def cap(text, n=120, width=200):
    """Keeps the panel fast: the last n lines, long lines cut."""
    lines = text.splitlines()
    out = [l if len(l) <= width else l[:width] + "..." for l in lines[-n:]]
    if len(lines) > n:
        out.insert(0, f"({len(lines) - n} earlier lines left out)")
    return "\n".join(out)


LOG_PARTS = {
    "log-system": lambda: section("Journal, system (warnings, this boot)",
        cap(run(["journalctl", "-b", "-p", "warning", "--no-pager", "-n", "300"], 30))),
    "log-user": lambda: section("Journal, user (warnings, this boot)",
        cap(run(["journalctl", "--user", "-b", "-p", "warning", "--no-pager", "-n", "150"], 30))),
    "log-prev": lambda: section("Journal, previous boot (errors)",
        cap(run(["journalctl", "-b", "-1", "-p", "err", "--no-pager", "-n", "100"], 30))),
    "log-kernel": lambda: section("Kernel warnings (this boot)",
        cap(run(["journalctl", "-k", "-b", "-p", "warning", "--no-pager", "-n", "150"], 30))),
    "log-failed": lambda: section("Failed services", run(["sh", "-c", FAILED_SERVICES], 30)),
    "log-crashes": lambda: section("Crashed programs (7 days)",
        cap(run(["sh", "-c", "coredumpctl list --no-pager --since=-7d 2>&1 | tail -n 25"], 30))),
    "log-noctalia": lambda: section("Noctalia log",
        cap(read_tail(os.path.join(HOME, ".cache", "noctalia", "noctalia.log"), 200))),
    "log-pacman": lambda: section("Pacman log (last 30 changes)",
        cap(read_tail("/var/log/pacman.log", 30, r"\] \[ALPM\] (upgraded|installed|removed)"))),
}


def logs():
    return "\n".join(f() for f in LOG_PARTS.values())


# --- report categories -------------------------------------------------
# (tool the command needs or "", title, shell command)

CATEGORIES = {
    "full": ("Full system", [
        ("inxi", "System report (inxi, full)", "inxi -c0 --admin --verbosity=7 --filter --no-host --width 100"),
    ]),
    "hardware-only": ("Hardware only", [
