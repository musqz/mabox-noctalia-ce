#!/usr/bin/env bash
# Toggle the pinned window of a Mabox plugin on its saved side.
#   mb-pinned <plugin>                       notes, status, colors, configs, capture, places, crypto
#   mb-pinned --side <plugin> [left|right]   print or set the side of a plugin
set -euo pipefail

file=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/pinned-side

plugins=(colors notes status configs capture places crypto)
side() { grep -qxs "$1=right" "$file" && echo right || echo left; }
close_pinned() { noctalia msg plugin "mabox/$1:pin" all hide >/dev/null 2>&1 || true; }

case ${1:-} in
    "" | -h | --help) sed -n '2,4p' "$0" | sed 's/^# \?//' ;;
    --side)
        [[ ${2:-} =~ ^[a-z0-9_-]+$ ]] || { echo "usage: mb-pinned --side <plugin> [left|right]" >&2; exit 2; }
        case ${3:-} in
            "") side "$2" ;;
            left | right)
                mkdir -p "${file%/*}"
                { grep -E '^[a-z0-9_-]+=' "$file" 2>/dev/null | grep -v "^$2=" || true; echo "$2=$3"; } | sort > "$file.tmp" && mv "$file.tmp" "$file" ;;
            *) echo "usage: mb-pinned --side <plugin> [left|right]" >&2; exit 2 ;;
        esac ;;
    *)
        [[ " ${plugins[*]} " == *" $1 "* ]] || { echo "unknown plugin: $1 (${plugins[*]})" >&2; exit 2; }
        s=$(side "$1")
        # windows on the same side lie on top of each other
        for o in "${plugins[@]}"; do
            if [[ $o != "$1" && $(side "$o") == "$s" ]]; then close_pinned "$o"; fi
        done
        exec noctalia msg plugin "mabox/$1:pin" all toggle ;;
esac
