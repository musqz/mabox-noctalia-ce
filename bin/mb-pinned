#!/usr/bin/env bash
# Toggle the pinned window of a Mabox plugin on its saved side.
#   mb-pinned <plugin>                       notes, status, colors, configs, capture
#   mb-pinned --side <plugin> [left|right]   print or set the side of a plugin
set -euo pipefail

file=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/pinned-side

plugins=(colors notes status configs capture)
layered=(status)   # pinned window is a layer, driven through the plugin's pin service

is_layered() { [[ " ${layered[*]} " == *" $1 "* ]]; }
close_pinned() {
    if is_layered "$1"; then noctalia msg plugin "mabox/$1:pin" all hide >/dev/null 2>&1 || true
    else noctalia msg panel-close "mabox/$1:pinned-$2" >/dev/null 2>&1 || true; fi
}

side() { grep -qxs "$1=right" "$file" && echo right || echo left; }

case ${1:-} in
    "" | -h | --help) sed -n '2,4p' "$0" | sed 's/^# \?//' ;;
    --side)
        [[ ${2:-} =~ ^[a-z0-9_-]+$ ]] || { echo "usage: mb-pinned --side <plugin> [left|right]" >&2; exit 2; }
        case ${3:-} in
            "") side "$2" ;;
            left | right)
                mkdir -p "${file%/*}"
                { grep -E '^[a-z0-9_-]+=' "$file" 2>/dev/null | grep -v "^$2=" || true; echo "$2=$3"; } | sort > "$file.tmp" && mv "$file.tmp" "$file" ;;
            *) echo "usage: mb-pinned --side <plugin> [left|right]" >&2; exit 2 ;;
        esac ;;
    *)
        [[ " ${plugins[*]} " == *" $1 "* ]] || { echo "unknown plugin: $1 (${plugins[*]})" >&2; exit 2; }
        s=$(side "$1")
        # windows on the same side lie on top of each other
        for o in "${plugins[@]}"; do
            if [[ $o != "$1" && $(side "$o") == "$s" ]]; then close_pinned "$o" "$s"; fi
        done
        if is_layered "$1"; then exec noctalia msg plugin "mabox/$1:pin" all toggle; fi
        exec noctalia msg panel-toggle "mabox/$1:pinned-$s" ;;
esac
