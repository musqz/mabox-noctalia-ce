#!/usr/bin/env bash
# Pick up to 4 windows in skippy-wl and tile them on the screen.
# Needs the labwc bind: <keybind key="W-A-C-8"><action name="UnSnap"/></keybind>
set -euo pipefail

mapfile -t ids < <(skippy-wl --show --multi-select || true)
n=${#ids[@]}
(( n > 0 )) || exit 0
if (( n > 4 )); then
	notify-send "skippy-tile" "Pick at most 4 windows ($n picked)"
	exit 1
fi

# slot -> key of the labwc keybind (see the rc.xml snippet)
case $n in
	1) keys=(7) ;;
	2) keys=(1 2) ;;
	3) keys=(1 4 6) ;;
	4) keys=(3 4 5 6) ;;
esac

for i in "${!ids[@]}"; do
	skippy-wl --activate "${ids[i]}"
	sleep 0.15
	# a window already snapped to that edge jumps to the neighbouring monitor
	wtype -M logo -M alt -M ctrl -k 8 -m ctrl -m alt -m logo
	sleep 0.1
	wtype -M logo -M alt -k "${keys[i]}" -m alt -m logo
	sleep 0.1
done
