#!/usr/bin/env python3
"""List and resume Claude Code, Codex and Agy sessions for the /ag launcher plugin.

Session formats follow mstio/mst.agent-launchers (MIT).

  mb-agent-sessions --json [QUERY]   installed agents + newest sessions as JSON
  mb-agent-sessions --panel [QUERY]  same with detail fields, 200 rows, plus the project folders
  mb-agent-sessions --set NAME DIR   set a project parent folder (github, aur)
  mb-agent-sessions --set terminal T   terminal for new windows (foot, kitty, alacritty, terminator, xfce4-terminal, xterm, auto)
  mb-agent-sessions --fav add|remove DIR | pick   favorite folders (pick opens a folder chooser)
  mb-agent-sessions --open KEY       resume a session (claude:ID, codex:ID, agy:ID) or focus its window
  mb-agent-sessions --start AGENT [DIR]   new session in DIR (default $HOME)
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from urllib.parse import unquote

HOME = os.path.expanduser("~")
CLAUDE = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
                     "mb-agent-sessions", "index.json")
UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{7,79}")
AGENTS = ("claude", "codex", "agy")
LABEL = {"claude": "Claude", "codex": "Codex", "agy": "Agy"}
LIMIT = 25
SCAN = 300  # newest transcript files read per agent
GENERIC = {"image attachment", "image", "screenshot", "untitled", "new session"}
# Titles and prompts are foreign content: no control or bidi characters.
CTRL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f؜​‎‏⁠﻿‪-‮⁦-⁩]")
# A session started from inside Claude would inherit these and not save its history.
CLAUDE_ENV = {"CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT"}


def clean(s):
    return " ".join(CTRL.sub("", s if isinstance(s, str) else "").split())


def allowed_dir(cwd):
    return (cwd == HOME or cwd.startswith(HOME + "/")) and ".." not in cwd.split("/") and os.path.isdir(cwd)


def short_dir(cwd):
    return "~" + cwd[len(HOME):] if cwd.startswith(HOME) else cwd


def records(path, needles=None, limit=None):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f):
                if limit and n >= limit:
                    return
                if needles and not any(t in line for t in needles):
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict):
                    yield r
    except OSError:
        return


def user_text(msg, n=80):
    c = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(c, list):
        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and isinstance(b.get("text"), str))
    if not isinstance(c, str):
        return ""
    c = re.sub(r"<system-reminder>.*?</system-reminder>", " ", c, flags=re.S)
    c = re.sub(r"\[(Image|Pasted text)[ :#][^\]]*\]", " ", c)
    c = clean(c)
    return "" if c.startswith(("<", "Caveat:", "[Request interrupted")) or len(c) < 8 else c[:n]


def parse_claude(path):
    title = cwd = first = last = ""
    count = 0
    for r in records(path, ('"type":"user"', '"ai-title"', '"custom-title"')):
        t = r.get("type")
        if t == "custom-title" and isinstance(r.get("customTitle"), str) and r["customTitle"]:
            title = r["customTitle"]
        elif t == "ai-title" and not title and isinstance(r.get("aiTitle"), str) and r["aiTitle"]:
            title = r["aiTitle"]
        elif t == "user" and not r.get("isSidechain") and not r.get("isMeta"):
            if not cwd and isinstance(r.get("cwd"), str):
                cwd = r["cwd"]
            t = user_text(r.get("message"), 300)
            if t:
                count += 1
                first = first or t
                last = t
    if not title or title.lower() in GENERIC:
        title = first or title
    return {"title": clean(title)[:80], "cwd": cwd, "ok": bool(first), "n": count, "first": first, "last": last}


def claude_sessions():
    try:
        with open(CACHE) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    files = []
    for p in glob.glob(os.path.join(CLAUDE, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(p)
        except OSError:
            continue
        files.append((st.st_mtime, st.st_size, p))
    files.sort(reverse=True)
    new, out = {}, []
    for mtime, size, p in files[:SCAN]:
        sid = os.path.basename(p)[:-6]
        if not UUID.fullmatch(sid):
            continue
        k = f"2:{mtime}:{size}"
        e = old.get(p)
        if not isinstance(e, dict) or e.get("k") != k:
            e = parse_claude(p)
            e["k"] = k
        new[p] = e
        if e["ok"] and e["cwd"]:
            out.append({"key": "claude:" + sid, "title": e["title"][:80] or sid[:8], "cwd": e["cwd"], "ts": mtime,
                        "n": e["n"], "first": e["first"], "last": e["last"]})
    if new != old:
        tmp = f"{CACHE}.{os.getpid()}"
        try:
            os.makedirs(os.path.dirname(CACHE), mode=0o700, exist_ok=True)
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(new, f)
            os.replace(tmp, CACHE)
        except OSError:
            pass
    return out


def codex_sessions():
    names = {}
    for r in records(os.path.join(HOME, ".codex", "session_index.jsonl")):
        if "id" in r:
            names[str(r["id"])] = str(r.get("thread_name") or "")
    files = []
    for p in glob.glob(os.path.join(HOME, ".codex", "sessions", "*", "*", "*", "rollout-*.jsonl")):
        try:
            files.append((os.stat(p).st_mtime, p))
        except OSError:
            continue
    files.sort(reverse=True)
    out = []
    for mtime, p in files[:SCAN]:
        meta = next(records(p, limit=1), {}).get("payload")
        if not isinstance(meta, dict) or meta.get("thread_source", "user") != "user":
            continue
        sid, cwd = str(meta.get("id") or ""), str(meta.get("cwd") or "")
        if SAFE_ID.fullmatch(sid) and cwd:
            out.append({"key": "codex:" + sid, "title": clean(names.get(sid)) or sid[:8], "cwd": cwd, "ts": mtime})
    return out


def agy_sessions():
    path = os.path.join(HOME, ".gemini", "antigravity-cli", "cache", "conversation_metadata.json")
    try:
        with open(path) as f:
            convs = json.load(f).get("conversations") or {}
    except (OSError, ValueError, AttributeError):
        return []
    out = []
    for cid, entry in convs.items():
        if not isinstance(entry, dict) or entry.get("is_internal") or not SAFE_ID.fullmatch(str(cid)):
            continue
        summ = entry.get("summary")
        if not isinstance(summ, dict):
            continue
        try:
            ts = datetime.fromisoformat(str(summ.get("UpdatedAt", "")).replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
        uris = summ.get("WorkspaceURIs") or []
        cwd = unquote(str(uris[0])[7:]) if uris and str(uris[0]).startswith("file://") else ""
        if cwd:
            out.append({"key": "agy:" + str(cid), "title": clean(summ.get("Title") or summ.get("Preview"))[:80] or str(cid)[:8], "cwd": cwd, "ts": ts})
    return out


def all_sessions():
    rows = []
    for fn in (claude_sessions, codex_sessions, agy_sessions):
        try:
            rows += fn()
        except Exception:
            continue
    rows = [r for r in rows if allowed_dir(r["cwd"])]
    rows.sort(key=lambda r: r["ts"], reverse=True)
    return rows


def installed():
    return [a for a in AGENTS if shutil.which(a)]


CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "mabox", "mb-agent-sessions.conf")
DIR_DEFAULTS = {"github": "~/Github", "aur": "~/AUR"}
TERMINALS = ("foot", "kitty", "alacritty", "terminator", "xfce4-terminal", "xterm")


def read_conf():
    out, favs, term = dict(DIR_DEFAULTS), [], ""
    try:
        with open(CONF) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "fav" and v:
                    favs.append(os.path.expanduser(v))
                elif k == "terminal" and v in TERMINALS:
                    term = v
                elif k in out and v:
                    out[k] = v
    except OSError:
        pass
    return {k: os.path.expanduser(v) for k, v in out.items()}, favs, term


def write_conf(d, favs, term=""):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in d.items()) + "".join(f"fav={v}\n" for v in favs)
                + (f"terminal={term}\n" if term else ""))


def set_dir(name, path):
    d, favs, term = read_conf()
    if name == "terminal":
        if path not in TERMINALS + ("auto",):
            fail("Unknown terminal")
        write_conf(d, favs, "" if path == "auto" else path)
        return
    path = os.path.abspath(os.path.expanduser(path))
    if name not in DIR_DEFAULTS or not allowed_dir(path):
        fail("Folder must be an existing folder under your home")
    d[name] = path
    write_conf(d, favs, term)


def fav(action, path=None):
    d, favs, term = read_conf()
    if action == "pick":
        picker = [["yad", "--file", "--directory", "--title=Favorite folder", "--filename=" + HOME + "/"],
                  ["zenity", "--file-selection", "--directory", "--title=Favorite folder", "--filename=" + HOME + "/"]]
        cmd = next((c for c in picker if shutil.which(c[0])), None)
        if cmd is None:
            fail("Install yad or zenity to pick a folder")
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            return
        path, action = r.stdout.strip(), "add"
    if not path:
        fail("Folder missing")
    path = os.path.abspath(os.path.expanduser(path))
    if action == "add":
        if not allowed_dir(path) or path == HOME:
            fail("Folder must be an existing folder under your home")
        if path not in favs:
            favs.append(path)
    elif action == "remove":
        favs = [f for f in favs if f != path]
    else:
        fail("Unknown favorite action")
    write_conf(d, favs, term)


def projects(rows):
    """[(dir, section)]: favorites, then git repos one level below the GitHub and AUR folders, then folders of earlier sessions."""
    d, favs, _ = read_conf()
    seen, out = set(), []
    cand = [(f, "fav") for f in favs]
    for name in ("github", "aur"):
        cand += [(os.path.dirname(g), name) for g in sorted(glob.glob(os.path.join(glob.escape(d[name]), "*", ".git")))]
    cand += [(r["cwd"], "recent") for r in rows]
    for p, section in cand:
        if p != HOME and p not in seen and allowed_dir(p):
            seen.add(p)
            out.append((p, section))
    return out


def cmd_json(query, panel=False):
    q = query.lower()
    rows = []
    have = installed()
    sessions = all_sessions()
    for r in sessions:
        agent = r["key"].split(":")[0]
        if agent not in have or q not in (r["title"] + " " + short_dir(r["cwd"])).lower():
            continue
        row = {"key": r["key"], "text": f"{LABEL[agent]}  {r['title']}  ·  {short_dir(r['cwd'])}"}
        if panel:
            row.update(agent=agent, title=r["title"], dir=short_dir(r["cwd"]), ts=int(r["ts"]),
                       n=r.get("n", 0), first=r.get("first", ""), last=r.get("last", ""))
        rows.append(row)
        if len(rows) == (200 if panel else LIMIT):
            break
    out = {"agents": have, "sessions": rows}
    if panel:
        out["terminals"] = [t for t in TERMINALS if shutil.which(t)]
        out["terminal"] = read_conf()[2]
    if panel or q:
        found = [{"dir": d, "text": short_dir(d), "section": sec} for d, sec in projects(sessions) if q in short_dir(d).lower()]
        out["projects"] = found[:200 if panel else 4]
    print(json.dumps(out))


def appid(sid):
    return "mb-agent-" + sid


def focus(app):
    if not shutil.which("wlrctl"):
        return False
    sel = "app_id:" + app
    try:
        return (subprocess.run(["wlrctl", "toplevel", "find", sel], capture_output=True, timeout=5).returncode == 0
                and subprocess.run(["wlrctl", "toplevel", "focus", sel], capture_output=True, timeout=5).returncode == 0)
    except (OSError, subprocess.SubprocessError):
        return False


def terminal(app):
    chosen = [t for t in (read_conf()[2], *os.environ.get("TERMINAL", "").split()[:1]) if t]
    for t in chosen + list(TERMINALS):
        if not shutil.which(t):
            continue
        name = os.path.basename(t)
        if name == "foot":
            return [t, "--app-id=" + app, "-e"]
        if name == "kitty":
            return [t, "--class", app]
        if name == "alacritty":
            return [t, "--class", app, "-e"]
        if name in ("terminator", "xfce4-terminal"):
            return [t, "-x"]
        return [t, "-e"]
    return None


def fail(msg):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", "AI agents", msg], timeout=5, check=False)
    sys.exit(msg)


def launch(argv, cwd, app):
    term = terminal(app)
    if term is None or not shutil.which(argv[0]) or not shutil.which("setsid"):
        fail(f"Cannot start {argv[0]}: terminal or program missing")
    env = {k: v for k, v in os.environ.items() if k not in CLAUDE_ENV and not k.startswith("CLAUDE_CODE_")}
    subprocess.Popen(["setsid", "-f"] + term + argv, cwd=cwd, env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_open(key):
    agent, _, sid = key.partition(":")
    ok = (UUID if agent == "claude" else SAFE_ID).fullmatch(sid) if agent in AGENTS else None
    if not ok:
        fail("Bad session key")
    if focus(appid(sid)):
        return
    cwd = next((r["cwd"] for r in all_sessions() if r["key"] == key), None)
    if not cwd:
        fail("Session not found")
    argv = {"claude": ["claude", "--resume", sid], "codex": ["codex", "resume", sid],
            "agy": ["agy", "--conversation", sid]}[agent]
    launch(argv, cwd, appid(sid))


def main():
    a = sys.argv[1:]
    if a[:1] == ["--json"]:
        cmd_json(" ".join(a[1:]).strip())
    elif a[:1] == ["--panel"]:
        cmd_json(" ".join(a[1:]).strip(), True)
    elif a[:1] == ["--set"] and len(a) == 3:
        set_dir(a[1], a[2])
    elif a[:1] == ["--fav"] and len(a) in (2, 3):
        fav(a[1], a[2] if len(a) == 3 else None)
    elif a[:1] == ["--open"] and len(a) == 2:
        cmd_open(a[1])
    elif a[:1] == ["--start"] and 2 <= len(a) <= 3 and a[1] in AGENTS:
        cwd = os.path.abspath(a[2]) if len(a) == 3 else HOME
        if not allowed_dir(cwd):
            fail("Folder must be an existing folder under your home")
        launch([a[1]], cwd, "mb-agent")
    else:
        sys.exit(__doc__)


main()
