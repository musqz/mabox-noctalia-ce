#!/usr/bin/env bash
# Set up a local calendar: radicale user service + vdir path for noctalia.
#   mb-calendar-setup
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/radicale/config
unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/radicale.service
data=${XDG_DATA_HOME:-$HOME/.local/share}/radicale/collections
user=${USER:-user}

if ! command -v radicale >/dev/null; then
    echo "radicale is not installed. Run: sudo pacman -S radicale" >&2
    exit 1
fi

if [[ -e $conf ]]; then
    echo "kept   $conf (check the paths below against its filesystem_folder)"
else
    install -d "$(dirname "$conf")"
    cat >"$conf" <<CONF
[server]
hosts = 127.0.0.1:5232

[auth]
type = none

[storage]
filesystem_folder = $data
CONF
    echo "wrote  $conf"
fi

if [[ -e $unit ]]; then
    echo "kept   $unit"
else
    install -d "$(dirname "$unit")"
    cat >"$unit" <<UNIT
[Unit]
Description=Radicale CalDAV server

[Service]
ExecStart=$(command -v radicale)
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
    echo "wrote  $unit"
fi

install -dm700 "$data"
systemctl --user daemon-reload
systemctl --user enable radicale
systemctl --user restart radicale
for _ in 1 2 3 4 5; do
    curl -fs -o /dev/null http://127.0.0.1:5232/ && break
    sleep 1
done || true
curl -fs -o /dev/null http://127.0.0.1:5232/ || { echo "radicale not answering: journalctl --user -u radicale" >&2; exit 1; }

cat <<EOF2

Next:
1. Open http://127.0.0.1:5232, sign in as "$user" with any password, create a calendar.
2. Thunderbird: New Calendar > On the Network > CalDAV, location http://127.0.0.1:5232/$user/<calendar-id>/
3. Noctalia: Settings > Calendar > Add account > Local (vdir), directory:
   $data/collection-root/$user
EOF2
