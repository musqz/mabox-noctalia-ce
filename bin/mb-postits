    "red": "#e5534b", "orange": "#f0883e", "yellow": "#d4a72c", "green": "#57ab5a", "teal": "#2ea89a",
    "cyan": "#39b5c7", "blue": "#539bf5", "purple": "#986ee2", "pink": "#e275ad",
}
SAVE_MS = 600
FONT_MIN, FONT_MAX, FONT_DEFAULT = 8, 28, 11
TODO_DIR = os.path.expanduser("~/.todo")
CALDIR = os.path.expanduser("~/caldir")
AGENDA_MAX = 30
AGENDA_DAYS = 30
