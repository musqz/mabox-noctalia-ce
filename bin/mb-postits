"""


def output_positions():
    """{(x, y): output name} from wlr-randr; GDK has no connector names."""
    pos, name = {}, None
    try:
        lines = subprocess.run(["wlr-randr"], capture_output=True, text=True).stdout.splitlines()
    except OSError:
        return pos
    for line in lines:
        if line and not line[0].isspace():
            name = line.split()[0]
        m = re.match(r"\s+Position:\s*(-?\d+),(-?\d+)", line)
        if m and name:
            pos[(int(m.group(1)), int(m.group(2)))] = name
    return pos


def monitors():
    """[(output name, Gdk.Monitor)]"""
    display = Gdk.Display.get_default()
    positions = output_positions()
    out = []
    for i in range(display.get_n_monitors()):
        mon = display.get_monitor(i)
        geom = mon.get_geometry()
        out.append((positions.get((geom.x, geom.y), ""), mon))
    return out


def load_layout():
    try:
        with open(LAYOUT) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_layout(layout):
    os.makedirs(STATE, exist_ok=True)
    tmp = LAYOUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(layout, f, indent=1)
    os.replace(tmp, LAYOUT)


def notes_dir():
    try:
        with open(os.path.join(DATA, "path")) as f:
            custom = f.read().strip()
    except OSError:
        custom = ""
    return custom.rstrip("/") or os.path.join(DATA, "notes")


def split_note(raw):
    """(header, body, fields): the header keeps its raw lines so a save never rewrites them."""
    raw = raw.replace("\r\n", "\n")
    fields, pos = {}, 0
    while pos < len(raw):
        nl = raw.find("\n", pos)
        line = raw[pos:] if nl < 0 else raw[pos:nl]
        m = re.match(r"^([A-Za-z]+):\s*(.*)$", line)
        if m and m.group(1) in ("title", "tags", "order", "favorite", "color", "screen"):
            fields[m.group(1)] = m.group(2).strip()
        else:
            if line == "" and nl >= 0:
                pos = nl + 1
            break
        pos = len(raw) if nl < 0 else nl + 1
    return raw[:pos], raw[pos:], fields


class Note:
    """One note file shown in a text view; writes back the body only."""

    def __init__(self, path):
        self.path, self.timer, self.dirty, self.loading, self.on_reload = path, 0, False, False, None
        self.view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=6, right_margin=6)
        self.buf = self.view.get_buffer()
        self.widget = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.widget.add(self.view)
        self.load()
        self.buf.connect("changed", self.on_changed)
        self.view.connect("focus-out-event", lambda *_: self.save() or False)
        self.monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", self.on_disk)

    def load(self):
        with open(self.path, encoding="utf-8") as f:
            raw = f.read()
        self.mtime = os.stat(self.path).st_mtime_ns
        self.header, body, self.fields = split_note(raw)
        self.loading = True
        self.buf.set_text(body)
        self.loading = False
        self.dirty = False

    def switch_off(self):
        """Drop the screen header line; the directory watch then closes the post-it."""
        self.save(force=True)
        if self.dirty:  # the typed text did not reach the file: keep the post-it
            subprocess.run(["notify-send", "mb-postits", f"Could not save {os.path.basename(self.path)}"])
            return
        try:
            with open(self.path, encoding="utf-8") as f:
                raw = f.read().replace("\r\n", "\n")
            header = split_note(raw)[0]
            new = re.sub(r"(?m)^screen:.*\n?", "", header) + raw[len(header):]
            tmp = self.path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(new)
            os.replace(tmp, self.path)
        except (OSError, UnicodeDecodeError) as e:
            print(f"mb-postits: {self.path}: {e}", file=sys.stderr)

    def title(self):
        if self.fields.get("title"):
            return self.fields["title"]
        for line in self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), False).splitlines():
            if line.strip():
                return line.lstrip("# \t").strip() or os.path.basename(self.path)
        return os.path.basename(self.path)

    def on_changed(self, _buf):
        if self.loading:
            return
        self.dirty = True
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(SAVE_MS, lambda: self.save(from_timer=True))

    def on_disk(self, *_):
        try:
            changed = os.stat(self.path).st_mtime_ns != self.mtime
        except OSError:
            return
        if changed and not self.dirty:
            try:
                self.load()
            except (OSError, UnicodeDecodeError):
                return
            if self.on_reload:
                self.on_reload()

    def save(self, force=False, from_timer=False):
        if self.timer and not from_timer:
            GLib.source_remove(self.timer)
        self.timer = 0
        if not self.dirty:
            return False
        try:
            if force:
                # Closing: keep the typed body under whatever header the file has now.
                with open(self.path, encoding="utf-8") as f:
                    header = split_note(f.read())[0]
                if header:  # an empty read is a half-written file: keep the old header
                    self.header = header
            elif os.stat(self.path).st_mtime_ns != self.mtime:
                self.load()  # another writer (Notes panel) won: keep its version
                subprocess.run(["notify-send", "mb-postits", f"{os.path.basename(self.path)} changed elsewhere; your last edit was dropped"])
                return False
            body = self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), False)
            if self.header and not self.header.endswith("\n"):
                self.header += "\n"
            tmp = self.path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(self.header + body)
            os.replace(tmp, self.path)
            self.mtime = os.stat(self.path).st_mtime_ns
            self.dirty = False
        except (OSError, UnicodeDecodeError) as e:
            print(f"mb-postits: {self.path}: {e}", file=sys.stderr)
        return False


def screen_notes():
    """Paths of the notes that have a 'screen: true' header line."""
    out = []
    try:
        names = sorted(os.listdir(notes_dir()))
    except OSError:
        return out
    for name in names:
        path = os.path.join(notes_dir(), name)
        if not name.endswith(".md"):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                fields = split_note(f.read())[2]
        except (OSError, UnicodeDecodeError):
            continue
        if fields.get("screen", "").strip().lower() == "true":
            out.append(path)
    return out


# The todo.txt rules below mirror parse/build in plugins/todo/lib/todo.luau so a tick writes what the panel writes.
def parse_task(raw):
    t = {"raw": raw}
    rest = raw
    done = rest.startswith("x ")
    if done:
        rest = rest[2:]
    m = re.match(r"^\(([A-Z])\) ", rest)
    t["pri"] = m.group(1) if m else None
    if m:
        rest = rest[4:]
    m = re.match(r"^(\d{4}-\d\d-\d\d) ", rest)
    t["created"] = None
    if m:
        rest = rest[11:]
        if done:
            m2 = re.match(r"^(\d{4}-\d\d-\d\d) ", rest)
            t["created"] = m2.group(1) if m2 else None
            if m2:
                rest = rest[11:]
        else:
            t["created"] = m.group(1)
    m = re.search(r"(?<!\S)due:(\d{4}-\d\d-\d\d)(?!\S)", rest)
    t["due"] = m.group(1) if m else None
    rest = re.sub(r"(?<!\S)due:\d{4}-\d\d-\d\d(?!\S)", "", rest)
    m = re.search(r"(?<!\S)color:([A-Za-z]+)(?!\S)", rest)
    t["color"] = m.group(1) if m else None
    rest = re.sub(r"(?<!\S)color:[A-Za-z]+(?!\S)", "", rest)
    m = re.search(r"(?<!\S)note:(\S+)", rest)
    t["note"] = m.group(1) if m else None
    rest = re.sub(r"(?<!\S)note:\S+", "", rest)
    t["pinned"] = re.search(r"(?<!\S)pin:1(?!\S)", rest) is not None
    rest = re.sub(r"(?<!\S)pin:1(?!\S)", "", rest)
    t["tags"] = re.findall(r"(?<!\S)[+@]\S+", rest)
    t["text"] = re.sub(r"(?<!\S)[+@]\S+", "", rest).strip()
    t["done"] = done
    return t


def encode_note(text):
    return re.sub(r"[^A-Za-z0-9_.,-]", lambda c: "".join(f"%{b:02X}" for b in c.group(0).encode()), text)


def decode_note(text):
    return re.sub(r"(?:%[0-9A-Fa-f]{2})+", lambda m: bytes.fromhex(m.group(0).replace("%", "")).decode("utf-8", "replace"), text)


def build_task(t):
    parts = []
    if t["pri"]:
        parts.append(f"({t['pri']})")
    if t["created"]:
        parts.append(t["created"])
    parts.append(t["text"])
    parts += t["tags"]
    if t["pinned"]:
        parts.append("pin:1")
    if t["note"]:
        parts.append("note:" + encode_note(decode_note(t["note"])))
    if t["color"]:
        parts.append("color:" + t["color"])
    if t["due"]:
        parts.append("due:" + t["due"])
    return " ".join(parts)


def complete_line(raw):
    t = parse_task(raw)
    t["pri"] = None
    return f"x {datetime.date.today().isoformat()} {build_task(t)}"


def due_kind(due):
    today = datetime.date.today().isoformat()
    if not due:
        return "nodate"
    if due < today:
        return "overdue"
    if due == today:
        return "today"
    if due == (datetime.date.today() + datetime.timedelta(days=1)).isoformat():
        return "tomorrow"
    if due <= (datetime.date.today() + datetime.timedelta(days=7)).isoformat():
        return "week"
    return "later"


class ListBody:
    """Scrolling list of label rows for the tasks and agenda post-its."""

    def __init__(self):
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=4)
        self.widget = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.widget.add(self.box)
        self.on_color = None
        self.cls = f"list{id(self)}"
        self.box.get_style_context().add_class(self.cls)
        self.font_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.font_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def save(self, **_):
        pass

    def set_font(self, pt):
        self.font_css.load_from_data(f".{self.cls} label {{ font-size: {pt}pt; }}".encode())

    def line(self, text, color, when, strike=False):
        """One row: text on the left, a due-colour dot and the date on the right."""
        row = Gtk.Box(spacing=6)
        label = Gtk.Label(label=text, xalign=0, wrap=True)
        label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        row.pack_start(label, True, True, 0)
        if when:
            dot = Gtk.Label(xalign=1)
            dot.set_markup(f'<span foreground="{color}">●</span> <small>{GLib.markup_escape_text(when)}</small>')
            row.pack_end(dot, False, False, 0)
        return row


def open_todo():
    try:
        subprocess.Popen(["noctalia", "msg", "panel-open", "mabox/todo:main"])
    except OSError as e:
        print(f"mb-postits: {e}", file=sys.stderr)
    return False


class Tasks(ListBody):
    """Open tasks of one todo.txt list; ticking one writes the done line back."""

    def __init__(self, name):
        super().__init__()
        self.name = name
        self.path = os.path.join(TODO_DIR, name + ".txt")
        self.refresh()
        self.monitor = Gio.File.new_for_path(TODO_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda _m, f, *_: f.get_basename() == name + ".txt" and self.refresh())
        GLib.timeout_add_seconds(60, self.refresh)  # due colours follow midnight

    def read(self):
        try:
            with open(self.path, encoding="utf-8") as f:
                return [l for l in f.read().split("\n") if l.strip()]
        except (OSError, UnicodeDecodeError):
            return []

    def refresh(self):
        if self.box.get_parent() is None:  # its window is gone: stop the minute timer
            return False
        everything = list(map(parse_task, self.read()))
        tasks = [t for t in everything if not t["done"]]
        tasks.sort(key=lambda t: (t["due"] is None, t["due"] or "", t["pri"] or "Z"))
        for child in self.box.get_children():
            child.destroy()
        for t in tasks + [t for t in everything if t["done"]]:  # done ones stay below, struck through
            self.box.pack_start(self.row(t), False, False, 0)
        if self.on_color:
            self.on_color(DUE_HEX[due_kind(tasks[0]["due"])] if tasks else DUE_HEX["nodate"])
        self.box.show_all()
        return True

    def row(self, t):
        row = Gtk.Box(spacing=6)
        check = Gtk.CheckButton(active=t["done"], tooltip_text="Mark as open" if t["done"] else "Mark as done")
        check.connect("toggled", lambda _c, raw=t["raw"]: GLib.idle_add(self.toggle, raw))
        row.pack_start(check, False, False, 0)
        label = Gtk.Label(xalign=0, wrap=True)
        if t["done"]:
            label.set_markup(f'<s>{GLib.markup_escape_text(t["text"])}</s>')
            label.set_opacity(0.45)
        else:
            label.set_text(t["text"])
        label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        open_panel = Gtk.EventBox()
        open_panel.add(label)
        open_panel.connect("button-press-event", lambda *_: open_todo())
        row.pack_start(open_panel, True, True, 0)
        if t["due"] and not t["done"]:
            try:
                when = datetime.date.fromisoformat(t["due"]).strftime("%x")
            except ValueError:
                when = t["due"]
            dot = Gtk.Label(xalign=1)
            dot.set_markup(f'<span foreground="{DUE_HEX[due_kind(t["due"])]}">●</span> <small>{GLib.markup_escape_text(when)}</small>')
            row.pack_end(dot, False, False, 0)
        return row

    def toggle(self, raw):
        # Re-read the file as it is now and change only this line; blank lines and the rest stay.
        path = os.path.realpath(self.path)
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().split("\n")
            if raw in lines:
                # Same as the panel: done lines get "x <date> " in front, reopening strips it.
                lines[lines.index(raw)] = re.sub(r"^x (\d{4}-\d\d-\d\d )?", "", raw, count=1) if raw.startswith("x ") else complete_line(raw)
                tmp = path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write("\n".join(lines))
                shutil.copymode(path, tmp)
                os.replace(tmp, path)
        except (OSError, UnicodeDecodeError) as e:
            print(f"mb-postits: {self.path}: {e}", file=sys.stderr)
        self.refresh()


def unescape(text):
    return re.sub(r"\\(.)", lambda m: "\n" if m.group(1) in "nN" else m.group(1), text)


def add_months(day, n):
    month = day.month - 1 + n
    year, month = day.year + month // 12, month % 12 + 1
    return day.replace(year=year, month=month)  # ValueError for a missing day (31st): that month is skipped


def occurrences(start, rule, until_day):
    """Start times of a recurring event up to until_day (simple RRULEs: FREQ, INTERVAL, COUNT, UNTIL, BYDAY for weekly)."""
    r = dict(p.split("=", 1) for p in rule.split(";") if "=" in p)
    freq, step = r.get("FREQ"), int(r.get("INTERVAL", 1))
    count = int(r["COUNT"]) if "COUNT" in r else None
    last = None
    if "UNTIL" in r:
        try:
            last = datetime.datetime.strptime(r["UNTIL"][:8], "%Y%m%d").date()
        except ValueError:
            pass
    days = [WEEKDAYS[d[-2:]] for d in r.get("BYDAY", "").split(",") if d[-2:] in WEEKDAYS]
    out, n = [], 0
    for k in range(5000):
        if freq == "DAILY":
            cands = [start + datetime.timedelta(days=k * step)]
        elif freq == "WEEKLY":
            monday = start - datetime.timedelta(days=start.weekday()) + datetime.timedelta(weeks=k * step)
            cands = [monday + datetime.timedelta(days=d) for d in (sorted(days) or [start.weekday()])]
            cands = [c for c in cands if c >= start]
        elif freq in ("MONTHLY", "YEARLY"):
            try:
                cands = [add_months(start, k * step * (12 if freq == "YEARLY" else 1))]
            except ValueError:
                cands = []
        else:
            return [start]
        for c in cands:
            if (last and c.date() > last) or c.date() > until_day or (count is not None and n >= count):
                return out
            n += 1
            out.append(c)
    return out


WEEKDAYS = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}


def read_events(now):
    """Upcoming events from caldir's .ics files as (start, all_day, summary), soonest first.

    Floating and TZID times are taken as local time. Recurring events are expanded for AGENDA_DAYS.
    """
    events = []
    horizon = now.date() + datetime.timedelta(days=AGENDA_DAYS)
    for path in glob.glob(os.path.join(CALDIR, "*", "*.ics")):
        try:
            with open(path, encoding="utf-8") as f:
                text = re.sub(r"\r?\n[ \t]", "", f.read())
        except (OSError, UnicodeDecodeError):
            continue
        for block in re.findall(r"BEGIN:VEVENT\r?\n(.*?)END:VEVENT", text, re.S):
            block = re.sub(r"BEGIN:VALARM.*?END:VALARM", "", block, flags=re.S)
            props = {}
            for line in block.splitlines():
                m = re.match(r"^([A-Z-]+)((?:;[^:]*)?):(.*)$", line)
                if m and m.group(1) not in props:
                    props[m.group(1)] = (m.group(2), m.group(3))
            if props.get("STATUS", ("", ""))[1] == "CANCELLED":
                continue
            try:
                start, all_day = parse_ics_time(*props["DTSTART"])
                if "DTEND" in props:
                    length = parse_ics_time(*props["DTEND"])[0] - start
                else:
                    length = datetime.timedelta(days=1) if all_day else datetime.timedelta()
            except (KeyError, ValueError):
                continue
            skip = {v[:8] for k, v in re.findall(r"^EXDATE([^:]*):(.*)$", block, re.M) for v in v.split(",")}
            summary = unescape(props.get("SUMMARY", ("", ""))[1]).strip() or "(no title)"
            starts = occurrences(start, props["RRULE"][1], horizon) if "RRULE" in props else [start]
            for st in starts:
                if st.strftime("%Y%m%d") in skip:
                    continue
                end = st + length
                if (end.date() > now.date()) if all_day else (end >= now):
                    shown = datetime.datetime.combine(max(st.date(), now.date()), datetime.time()) if all_day and st.date() < now.date() else st
                    events.append((shown, all_day, summary))
    events.sort(key=lambda e: (e[0], not e[1]))
    return events


def parse_ics_time(params, value):
    if "VALUE=DATE" in params and "T" not in value:
        return datetime.datetime.strptime(value, "%Y%m%d"), True
    if value.endswith("Z"):
        utc = datetime.datetime.strptime(value, "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
        return utc.astimezone().replace(tzinfo=None), False
    return datetime.datetime.strptime(value, "%Y%m%dT%H%M%S"), False


class Agenda(ListBody):
    """Next events of the caldir calendars, read-only."""

    def __init__(self):
        super().__init__()
        self.monitors = []
        self.pending = 0
        for d in [CALDIR] + glob.glob(os.path.join(CALDIR, "*", "")):
            if os.path.isdir(d):
                mon = Gio.File.new_for_path(d).monitor_directory(Gio.FileMonitorFlags.NONE, None)
                mon.connect("changed", self.on_change)
                self.monitors.append(mon)
        self.monitor = self  # same cancel() hook the other post-its have
        self.refresh()
        GLib.timeout_add_seconds(60, self.refresh)

    def on_change(self, *_):
        if not self.pending:  # a sync writes many files: refresh once afterwards
            self.pending = GLib.timeout_add(500, self.later)

    def later(self):
        self.pending = 0
        self.refresh()
        return False

    def cancel(self):
        for mon in self.monitors:
            mon.cancel()

    def refresh(self):
        if self.box.get_parent() is None:
            return False
        now = datetime.datetime.now()
        events = read_events(now)[:AGENDA_MAX]
        for child in self.box.get_children():
            child.destroy()
        for start, all_day, summary in events:
            kind = due_kind(max(start.date(), now.date()).isoformat())
            when = {"today": "Today", "tomorrow": "Tomorrow"}.get(kind) or start.strftime("%a %x")
            if not all_day:
                when += start.strftime(" %H:%M")
            self.box.pack_start(self.line(summary, DUE_HEX[kind], when), False, False, 0)
        if not events:
            self.box.pack_start(Gtk.Label(label="No upcoming events", xalign=0), False, False, 0)
        if self.on_color:
            self.on_color(DUE_HEX[due_kind(max(events[0][0].date(), now.date()).isoformat())] if events else DUE_HEX["nodate"])
        self.box.show_all()
        return True


CONF = os.path.expanduser("~/.config/mabox-noctalia-ce/postits.conf")  # the Todo plugin writes the same path


def conf_keys():
    """Window keys switched on in postits.conf: lines 'tasks LIST' and 'agenda'."""
    keys = set()
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f.read().split("\n"):
                kind, _, name = line.strip().partition(" ")
                if kind == "tasks" and name and "/" not in name:
                    keys.add("tasks:" + name)
                elif kind == "agenda":
                    keys.add("agenda")
    except (OSError, UnicodeDecodeError):
        pass
    return keys


def conf_set(key, on):
    line = "agenda" if key == "agenda" else "tasks " + key.split(":", 1)[1]
    try:
        with open(CONF, encoding="utf-8") as f:
            lines = [l for l in f.read().split("\n") if l.strip()]
    except (OSError, UnicodeDecodeError):
        lines = []
    lines = [l for l in lines if l != line] + ([line] if on else [])
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("".join(l + "\n" for l in lines))
    os.replace(tmp, CONF)


class Postit(Gtk.Window):
    def __init__(self, key, title, content, hex_color, layout, layer, slot=0):
        super().__init__()
        self.key, self.layout = key, layout
        self.outs = monitors()
        saved = layout.get(key, {})
        self.x, self.y = saved.get("x", 60 + 30 * slot), saved.get("y", 60 + 30 * slot)
        self.w, self.h = saved.get("w", 260), saved.get("h", 200)
        # A saved output that is gone falls back to the first one.
        names = [n for n, _ in self.outs]
        self.output = saved.get("output") if saved.get("output") in names else names[0]
        mon = dict(self.outs)[self.output]
        geom = mon.get_geometry()
        self.w, self.h = min(self.w, geom.width), min(self.h, geom.height)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, layer)
        GtkLayerShell.set_namespace(self, "mb-postits")
        GtkLayerShell.set_monitor(self, mon)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        self.apply_margins()
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_size_request(int(self.w), int(self.h))

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=8)
        frame.get_style_context().add_class("postit")
        tint = Gtk.CssProvider()
        tint.load_from_data(f".postit {{ background: {hex_color}; }}".encode())
        frame.get_style_context().add_provider(tint, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        font = saved.get("font", FONT_DEFAULT)
        self.font = min(FONT_MAX, max(FONT_MIN, int(font))) if isinstance(font, (int, float)) else FONT_DEFAULT
        self.content = content
        self.font_css = Gtk.CssProvider()
        content.get_child().get_style_context().add_provider(self.font_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.apply_font()
        self.title_label = Gtk.Label(label=title, ellipsize=Pango.EllipsizeMode.END)
        self.on_close = self.on_close_all = self.on_remove = None
        buttons = []
        for glyph, tip, name in (("–", "Hide (comes back on the next start)", "on_close"), ("✕", "Remove from screen (the note is kept)", "on_remove")):
            btn = Gtk.Button(label=glyph, relief=Gtk.ReliefStyle.NONE, tooltip_text=tip)
            btn.get_style_context().add_class("postit-close")
            btn.connect("clicked", lambda _b, name=name: getattr(self, name) and getattr(self, name)())
            buttons.append(btn)
        bar = Gtk.Box()
        bar.set_center_widget(self.title_label)
        for btn in reversed(buttons):
            bar.pack_end(btn, False, False, 0)
        head = Gtk.EventBox()
        head.add(bar)
        head.get_style_context().add_class("postit-title")
        self.head_css = Gtk.CssProvider()
        head.get_style_context().add_provider(self.head_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        head.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
        head.connect("button-press-event", self.head_press)
        head.connect("motion-notify-event", self.drag_move)
        head.connect("button-release-event", self.drag_end)
        frame.pack_start(head, False, False, 0)
        frame.pack_start(content, True, True, 0)

        grip = Gtk.EventBox(halign=Gtk.Align.END)
        grip.add(Gtk.Label(label="◢"))
        grip.get_style_context().add_class("postit-grip")
        grip.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
        grip.connect("button-press-event", self.grip_start)
        grip.connect("motion-notify-event", self.grip_move)
        grip.connect("button-release-event", self.drag_end)
        frame.pack_start(grip, False, False, 0)
        self.add(frame)
        self.show_all()

    def apply_margins(self):
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(0, int(self.y)))
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(0, int(self.x)))

    # Pointer coordinates are surface-relative, so while the window follows the
    # pointer they stay at the press point: each event's offset is the new step.
    def head_press(self, widget, ev):
        if ev.button == 3:
            menu = Gtk.Menu()
            for name, w, h in SIZES:
                item = Gtk.MenuItem(label=f"{name}  {w}x{h}")
                item.connect("activate", lambda _i, w=w, h=h: self.set_size(w, h))
                menu.append(item)
            menu.append(Gtk.SeparatorMenuItem())
            for label, step in (("Text bigger", 1), ("Text smaller", -1)):
                item = Gtk.MenuItem(label=f"{label}  ({self.font} pt)")
                item.connect("activate", lambda _i, step=step: self.set_font(self.font + step))
                menu.append(item)
            menu.append(Gtk.SeparatorMenuItem())
            for label, cb in (("Hide this one", self.on_close), ("Close all", self.on_close_all), ("Remove from screen", self.on_remove)):
                item = Gtk.MenuItem(label=label)
                item.connect("activate", lambda _i, cb=cb: cb and cb())
                menu.append(item)
            menu.show_all()
            menu.popup_at_pointer(ev)
        elif ev.button == 1:
            self.p0 = (ev.x_root, ev.y_root)
            self.dragging = "move"
            self.last = ev.time
        return True

    def set_size(self, w, h):
        self.w, self.h = w, h
        self.set_size_request(w, h)
        self.resize(w, h)
        self.save_pos()

    def set_head_color(self, hex_color):
        self.head_css.load_from_data(f".postit-title {{ background: {hex_color}; }}".encode())

    def apply_font(self):
        self.font_css.load_from_data(f"textview, textview text {{ font-size: {self.font}pt; }}".encode())
        if hasattr(self.content, "set_font"):
            self.content.set_font(self.font)

    def set_font(self, pt):
        self.font = min(FONT_MAX, max(FONT_MIN, pt))
        self.apply_font()
        self.save_pos()

    def save_pos(self):
        self.layout[self.key] = {"x": int(self.x), "y": int(self.y), "w": int(self.w), "h": int(self.h), "output": self.output, "font": self.font}
        save_layout(self.layout)

    def drag_move(self, widget, ev):
        # Events that arrive before the compositor has moved the surface carry stale coordinates.
        if getattr(self, "dragging", None) == "move" and ev.time - self.last >= 40:
            self.last = ev.time
            self.x = max(0, self.x + ev.x_root - self.p0[0])
            self.y = max(0, self.y + ev.y_root - self.p0[1])
            self.moved = True
            self.apply_margins()
        return True

    def grip_start(self, widget, ev):
        if ev.button == 1:
            self.p0 = (ev.x_root, ev.y_root)
            self.dragging = "size"
            self.size0 = (self.w, self.h)
        return True

    def grip_move(self, widget, ev):
        if getattr(self, "dragging", None) == "size":
            # The top-left corner is fixed while resizing, so the offset from the press point is absolute.
            mon = dict(self.outs)[self.output].get_geometry()
            self.w = min(mon.width, max(MIN_W, self.size0[0] + ev.x_root - self.p0[0]))
            self.h = min(mon.height, max(MIN_H, self.size0[1] + ev.y_root - self.p0[1]))
            self.moved = True
            self.set_size_request(int(self.w), int(self.h))
            self.resize(int(self.w), int(self.h))
        return True

    def drag_end(self, widget, ev):
        if getattr(self, "dragging", None):
            self.dragging = None
            if not getattr(self, "moved", False):
                return True
            self.moved = False
            self.save_pos()
        return True


def main():
    pidfile = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mb-postits.pid")
    try:
        with open(pidfile) as f:
            pid = int(f.read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            running = b"mb-postits" in f.read()
        if running:
            os.kill(pid, 15)
            return 0
    except (OSError, ValueError):
        pass
    layer = GtkLayerShell.Layer.TOP if "--front" in sys.argv else GtkLayerShell.Layer.BOTTOM
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))
    shown = {}  # note path -> (Note, Postit)
    hidden = set()  # closed for this session only
    pending = [0]
    opened = [0]  # cascade slot for notes without a saved position

    def quit_all():
        for n, _ in shown.values():
            n.save(force=True)
        Gtk.main_quit()

    signal_add(GLib.PRIORITY_DEFAULT, 15, quit_all)
    try:
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        layout = load_layout()

        args = sys.argv[1:]
        cli = {"tasks:" + args[i + 1] for i, a in enumerate(args) if a in ("--tasks", "--task") and i + 1 < len(args) and "/" not in args[i + 1]}
        if "--agenda" in args:
            cli.add("agenda")

        def close(key):
            body, win = shown.pop(key)
            body.save(force=True)
            body.monitor.cancel()
            win.destroy()

        def open_extra(key):
            if key == "agenda":
                body, title = Agenda(), "Agenda"
            else:
                body = Tasks(key.split(":", 1)[1])
                title = "Tasks · " + body.name
            win = Postit(key, title, body.widget, PAPER, layout, layer, opened[0])
            opened[0] += 1
            body.on_color = win.set_head_color
            body.refresh()
            win.on_close = lambda k=key: hide(k)
            win.on_remove = lambda k=key: remove_extra(k)
            win.on_close_all = quit_all
            shown[key] = (body, win)

        def remove_extra(key):
            if key in conf_keys():
                try:
                    conf_set(key, False)
                except OSError as e:
                    print(f"mb-postits: {CONF}: {e}", file=sys.stderr)
            hide(key)  # also when it came from a command line option

        def sync():
            """Open a post-it for every note, list or agenda switched on, close the ones switched off."""
            pending[0] = 0
            on = screen_notes()
            extra = cli | conf_keys()
            hidden.intersection_update(set(on) | extra)  # switched off elsewhere: it may come back
            want = [p for p in on if p not in hidden]
            for path in [p for p in shown if p not in want and p not in extra]:
                close(path)
            for path in want:
                if path in shown:
                    continue
                try:
                    note = Note(path)
                except (OSError, UnicodeDecodeError):
                    continue
                win = Postit(os.path.basename(path), note.title(), note.widget, COLORS.get(note.fields.get("color"), COLORS["yellow"]), layout, layer, opened[0])
                opened[0] += 1
                win.on_close = lambda p=path: hide(p)
                win.on_close_all = quit_all
                win.on_remove = note.switch_off
                note.on_reload = lambda n=note, w=win: w.title_label.set_text(n.title())
                shown[path] = (note, win)
            for key in sorted(extra):
                if key in shown or key in hidden:
                    continue
                if key.startswith("tasks:") and not os.path.exists(os.path.join(TODO_DIR, key[6:] + ".txt")):
                    continue  # list deleted or renamed outside the panel
                open_extra(key)
            return False

        def hide(path):
            if path not in shown:
                return
            close(path)
            hidden.add(path)
            if not shown:
                Gtk.main_quit()

        sync()
        if not shown:
            subprocess.run(["notify-send", "mb-postits", "Nothing to show: switch on a note, a todo list or the agenda"])
            return 1

        def on_timer():
            sync()
            if not shown:
                Gtk.main_quit()
            return False

        def on_dir(_mon, f, _other, _event):
            if f.get_basename().endswith(".tmp"):
                return
            if not pending[0]:
                pending[0] = GLib.timeout_add(200, on_timer)

        def on_conf(_mon, f, _other, _event):
            if f.get_basename() == "postits.conf":
                on_dir(_mon, f, _other, _event)

        watch = Gio.File.new_for_path(notes_dir()).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        watch.connect("changed", on_dir)
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        conf_watch = Gio.File.new_for_path(os.path.dirname(CONF)).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        conf_watch.connect("changed", on_conf)
        Gtk.main()
    finally:
        try:
            os.unlink(pidfile)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
