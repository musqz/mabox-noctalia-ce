#!/usr/bin/env python3
"""mb-keys - list the labwc keybinds of rc.xml for the mabox/keys plugin.

  mb-keys list [--tsv] [--rc FILE]
  mb-keys profiles --tsv
  mb-keys app NAME --tsv
  mb-keys focused

Descriptions: keys.csv (key,group,basic,description), else the comment above
a lone keybind, else the command.
"""
import csv
import os
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET

CFG = os.path.join(os.environ["HOME"], ".config", "mabox-noctalia-ce", "rc.xml")
CSV_PATHS = (
    "/usr/share/mabox-noctalia-ce/keys.csv",
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lists", "keys.csv"),
)
PROFILE_PATHS = (
    "/usr/share/mabox-noctalia-ce/keys-profiles.csv",
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lists", "keys-profiles.csv"),
)
APPKEY_DIRS = (
    "/usr/share/mabox-noctalia-ce/appkeys",
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lists", "appkeys"),
)
GEANY_CONF = os.path.join(os.environ["HOME"], ".config", "geany", "keybindings.conf")
KITTY_CONF = os.path.join(os.environ["HOME"], ".config", "kitty", "kitty.conf")
APP_MODS = {"primary": "Ctrl", "control": "Ctrl", "ctrl": "Ctrl", "shift": "Shift", "alt": "Alt",
            "super": "Super", "mod1": "Alt", "mod4": "Super", "cmd": "Super"}
APP_KEYS = {"page_up": "PgUp", "page_down": "PgDn", "prior": "PgUp", "next": "PgDn",
            "return": "Enter", "escape": "Esc", "space": "Space", "plus": "+", "minus": "-",
            "equal": "=", "comma": ",", "period": ".", "slash": "/", "backslash": "\\"}
# Several actions on one bind: show the first one found in this order.
PREFERRED = ("Execute", "ShowMenu", "MoveResizeTo", "SnapToEdge",
             "GrowToEdge", "SendToDesktop", "GoToDesktop")
MODS = {"W": "Super", "A": "Alt", "C": "Ctrl", "S": "Shift", "M": "Mod", "H": "Hyper"}
KEYS = {"space": "Space", "Return": "Enter", "grave": "`", "slash": "/", "comma": ",",
        "period": ".", "minus": "-", "equal": "=", "Prior": "PgUp", "Next": "PgDn",
        "Escape": "Esc", "BackSpace": "Backspace"}


# Binds labwc loads for <keyboard><default />; a bind in rc.xml with the same key replaces it.
DEFAULTS = (
    ("A-Tab", "Next window"),
    ("A-S-Tab", "Previous window"),
    ("W-Return", "Terminal (lab-sensible-terminal)"),
    ("A-F4", "Close window"),
    ("W-a", "Toggle maximize"),
    ("W-d", "Show desktop"),
    ("W-Left", "Window to the left half"),
    ("W-Right", "Window to the right half"),
    ("W-Up", "Window to the top half"),
    ("W-Down", "Window to the bottom half"),
    ("A-Space", "Window menu"),
)


def clean(text):
    text = " ".join((text or "").split())
    return text or None


def value(el, name):
    """Attribute or child element called name."""
    v = clean(el.get(name))
    if v is None:
        child = el.find(name)
        v = clean(child.text) if child is not None else None
    return v


def actions(kb):
    """(name, getter) for every action, <action> blocks and the name.action shorthand."""
    out = [(a.get("name"), lambda k, el=a: value(el, k)) for a in kb.findall("action") if a.get("name")]
    short = clean(kb.get("name.action"))
    if short:
        out.append((short, lambda k: clean(kb.get(k + ".action"))))
    return out


def describe(name, get):
    if name == "Execute":
        return get("command") or get("execute") or "Execute"
    if name == "MoveResizeTo":
        parts = [t + ":" + get(t) for t in ("x", "y", "width", "height") if get(t)]
        return " ".join(["MoveResizeTo"] + parts)
    if name == "ShowMenu":
        return "ShowMenu " + (get("menu") or "")
    extra = [get(t) for t in ("direction", "to", "output") if get(t)]
    return " ".join([name] + extra)


def pick(acts):
    for wanted in PREFERRED:
        for a in acts:
            if a[0] == wanted:
                return a
    return acts[0]


def split_key(spec):
    parts = spec.split("-")
    # a trailing "-" is the minus key: W-- gives ["W", "", ""]
    if spec.endswith("-") and len(parts) > 1:
        parts = parts[:-2] + ["-"]
    key = parts[-1]
    mods = [MODS.get(m, m) for m in parts[:-1]]
    return mods, KEYS.get(key, key if len(key) > 1 else key.upper() if key.isalpha() else key)


def ident(spec):
    mods, key = split_key(spec)
    return frozenset(mods), key.lower()


def read_csv():
    for path in CSV_PATHS:
        if os.path.isfile(path):
            with open(path, newline="", encoding="utf-8") as f:
                rows = csv.reader(row for row in f if row.strip() and not row.startswith("#"))
                return {r[0]: r for r in rows if len(r) >= 4}
    return {}


def installed(row):
    """An app profile shows only when its source or one of its app ids is a command on PATH."""
    names = [row[2]] + (row[3].split("+") if len(row) > 3 else [])
    return any(shutil.which(n) for n in names)


def profiles():
    for path in PROFILE_PATHS:
        if os.path.isfile(path):
            with open(path, newline="", encoding="utf-8") as f:
                rows = csv.reader(row for row in f if row.strip() and not row.startswith("#"))
                return [r for r in rows if len(r) >= 3 and (r[1] != "app" or installed(r))]
    return []


def app_key(parts):
    """Normalize modifier and key names (['primary', 'shift', 'page_up']) to 'Ctrl+Shift+PgUp'."""
    mods = {APP_MODS[p.lower()] for p in parts[:-1] if p.lower() in APP_MODS}
    mods = [m for m in ("Ctrl", "Alt", "Shift", "Super") if m in mods]
    key = parts[-1]
    key = APP_KEYS.get(key.lower(), key.upper() if len(key) == 1 else key.capitalize())
    return "+".join(mods + [key])


def geany_binds():
    out = []
    try:
        with open(GEANY_CONF, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return out
    for line in lines:
        name, sep, value = line.partition("=")
        value = value.split("|")[0].strip()
        if not sep or not value or name.startswith("["):
            continue
        parts = value.replace("<", " ").replace(">", " ").split()
        if not parts or parts[-1].lower() in APP_MODS:
            continue
        section, _, rest = name.partition("_")
        out.append((section.capitalize() if rest else "Config", app_key(parts), (rest or name).replace("_", " ").capitalize()))
    return out


def kitty_binds():
    out = []
    try:
        with open(KITTY_CONF, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return out
    kitty_mod = "ctrl+shift"
    for line in lines:
        w = line.split(None, 2)
        if len(w) == 2 and w[0] == "kitty_mod":
            kitty_mod = w[1]
        elif len(w) == 3 and w[0] == "map" and ">" not in w[1] and w[2] not in ("no_op", "discard_event"):
            keys = w[1].replace("kitty_mod", kitty_mod)
            out.append(("Config", app_key(keys.split("+")), w[2].replace("_", " ")))
    return out


def app_binds(name):
    rows = []
    for d in APPKEY_DIRS:
        path = os.path.join(d, name + ".csv")
        if os.path.isfile(path):
            with open(path, newline="", encoding="utf-8") as f:
                rows = [tuple(r[:3]) for r in csv.reader(x for x in f if x.strip() and not x.startswith("#")) if len(r) >= 3]
            break
    live = {"geany": geany_binds, "kitty": kitty_binds}.get(name, lambda: [])()
    taken = {r[1] for r in live}
    return live + [r for r in rows if r[1] not in taken]


def comment_labels(keyboard):
    """Comment text for a keybind that is the only one below its comment."""
    labels, pending, group = {}, None, []

    def flush():
        if pending and len(group) == 1:
            labels[id(group[0])] = pending

    for child in keyboard:
        if child.tag is ET.Comment:
            flush()
            pending, group = clean(child.text), []
        elif child.tag == "keybind":
            group.append(child)
    flush()
    return labels


def collect(rc):
    parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))
    root = ET.parse(rc, parser).getroot()
    meta = read_csv()
    binds = []
    taken = set()
    uses_defaults = False
    for keyboard in root.iter("keyboard"):
        uses_defaults = uses_defaults or keyboard.find("default") is not None
        labels = comment_labels(keyboard)
        for kb in keyboard.findall("keybind"):
            spec = kb.get("key")
            if spec:
                taken.add(ident(spec))
            acts = [a for a in actions(kb) if a[0] != "None"]
            if not spec or not acts:
                continue
            name, get = pick(acts)
            command = describe(name, get)
            row = meta.get(spec)
            mods, key = split_key(spec)
            binds.append({
                "spec": spec,
                "mods": mods,
                "key": key,
                "group": row[1] if row else "Other",
                "basic": bool(row and row[2].strip() == "1"),
                "desc": (row[3] if row else None) or labels.get(id(kb)) or command,
                "command": command,
                "run": name == "Execute",
            })
    if uses_defaults or not binds:
        for spec, desc in DEFAULTS:
            if ident(spec) not in taken:
                mods, key = split_key(spec)
                row = meta.get(spec)
                binds.append({"spec": spec, "mods": mods, "key": key,
                              "group": row[1] if row else "labwc defaults",
                              "basic": bool(row and row[2].strip() == "1"),
                              "desc": row[3] if row else desc, "command": "labwc default", "run": False})
    return binds


def main(argv):
    if argv and argv[0] == "profiles":
        for r in profiles():
            print("\t".join(r[:3]))
        return 0
    if argv and argv[0] == "focused":
        for r in profiles():
            for app_id in (r[3].split("+") if len(r) > 3 else []):
                try:
                    found = subprocess.run(["wlrctl", "toplevel", "find", "app_id:" + app_id, "state:focused"],
                                           capture_output=True).returncode == 0
                except OSError:
                    return 0
                if found:
                    print(r[0])
                    return 0
        return 0
    if len(argv) >= 2 and argv[0] == "app":
        for section, keys, desc in app_binds(argv[1]):
            parts = keys.split("+")
            if keys.endswith("+"):
                parts = keys[:-1].split("+")[:-1] + ["+"] if keys != "+" else ["+"]
            print("\t".join([keys, "+".join(parts[:-1]), parts[-1], section, "1", desc, "", "0"]))
        return 0
    if not argv or argv[0] != "list":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    rc = CFG
    if "--rc" in argv:
        rc = os.path.expanduser(argv[argv.index("--rc") + 1])
    try:
        binds = collect(rc)
    except (OSError, ET.ParseError) as e:
        print("mb-keys: " + str(e), file=sys.stderr)
        return 1
    if "--tsv" in argv:
        for b in binds:
            print("\t".join([b["spec"], "+".join(b["mods"]), b["key"], b["group"],
                             "1" if b["basic"] else "0", b["desc"], b["command"],
                             "1" if b["run"] else "0"]))
    else:
        for b in binds:
            print("{:<18} {:<10} {}".format(b["spec"], b["group"], b["desc"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
