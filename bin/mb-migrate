#!/usr/bin/env bash
# One-time fixes for config files that were copied from an older release.
# Add a migrate_N function per change; the last applied N is kept in the state dir.
set -euo pipefail

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
stamp=$state_home/mabox-noctalia-ce/config-version
files=("${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/config.toml" "$state_home/noctalia/settings.toml")

# Exact-string replace: a value the user changed no longer matches and stays.
replace() {
    local f c
    for f in "${files[@]}"; do
        [[ -f $f ]] || continue
        c=$(<"$f")
        printf '%s\n' "${c//"$1"/"$2"}" > "$f"
    done
}

migrate_1() { replace 'exec mb-updates-ce menu' 'exec noctalia msg panel-toggle mabox/status:updates'; }
migrate_2() {
    local f=${files[0]}
    [[ -f $f ]] || return 0
    grep -q '^\[theme\.templates\.user\.mabox-logo\]' "$f" && return 0
    cat >> "$f" <<'TOML'

[theme.templates.user.mabox-logo]
input_path = "~/.config/noctalia/templates/mabox-logo.svg"
output_path = "~/.local/share/mabox-noctalia-ce/mabox-logo.svg"
TOML
}

# Add the cava keybind and window rule; an existing one is the user's and stays.
migrate_3() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && ! grep -q cava-transparent "$f" || return 0
    grep -q "</keyboard>" "$f" && grep -q "</windowRules>" "$f" || return 0
    sed -i 's#</keyboard>#    <keybind key="C-A-v" name.action="Execute" command.action="jumpapp -m -c cava-transparent mb-cava"/>\n  </keyboard>#' "$f"
    sed -i 's#</windowRules>#    <windowRule identifier="cava-transparent">\n      <action name="SetDecorations" decorations="none"/>\n      <action name="AutoPlace" policy="center"/>\n      <action name="MoveToEdge" direction="down" snapWindows="no"/>\n    </windowRule>\n  </windowRules>#' "$f"
}

# Cava follows the wallpaper colors through a Noctalia template (mb-cava-theme is its hook); add the config block once the template is in place.
migrate_4() {
    local f=${files[0]}
    local tpl=${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/templates/cava-palette
    [[ -f $f && -e $tpl ]] || return 0
    grep -q '^\[theme\.templates\.user\.cava\]' "$f" && return 0
    cat >> "$f" <<'TOML'

[theme.templates.user.cava]
input_path = "~/.config/noctalia/templates/cava-palette"
output_path = "~/.cache/mabox-noctalia-ce/cava-palette"
post_hook = "mb-cava-theme"
TOML
}

# Window rules for the cava layer (always on top, always below); an existing file with them is left alone.
migrate_5() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && ! grep -q cavatransparent-top "$f" || return 0
    grep -q "</windowRules>" "$f" && grep -q 'identifier="cava-transparent"' "$f" || return 0
    sed -i 's#</windowRules>#    <windowRule title="cavatransparent-top">\n      <action name="ToggleAlwaysOnTop"/>\n    </windowRule>\n    <windowRule title="cavatransparent-below">\n      <action name="ToggleAlwaysOnBottom"/>\n    </windowRule>\n  </windowRules>#' "$f"
    labwc --reconfigure >/dev/null 2>&1 || true
}

# New Mabox plugins are enabled once by mb-plugins-enable, which the autostart runs after the plugin source is added.
migrate_6() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/autostart
    [[ -f $f ]] && ! grep -q mb-plugins-enable "$f" || return 0
    grep -q "plugins source add mabox path" "$f" || return 0
    sed -i '/plugins source add mabox path/a command -v mb-plugins-enable >/dev/null \&\& (sleep 6 \&\& mb-plugins-enable) >/dev/null 2>\&1 \&' "$f"
}

# W-A-v opens the Cava panel; a key the user already bound stays as it is.
migrate_7() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && ! grep -q 'key="W-A-v"' "$f" || return 0
    grep -q "</keyboard>" "$f" || return 0
    sed -i 's#</keyboard>#    <keybind key="W-A-v" name.action="Execute" command.action="noctalia msg panel-open mabox/cava:main"/>\n  </keyboard>#' "$f"
    labwc --reconfigure >/dev/null 2>&1 || true
}

# The Cava follow-colors choice needs the secondary color in the palette template.
migrate_8() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/templates/cava-palette
    [[ -f $f ]] && ! grep -q secondary "$f" || return 0
    sed -i '/tertiary/i {{ colors.secondary.default.hex }}' "$f"
}

# W-c opens the Colors panel, C-W-c the pinned Colors window; a key the user already bound stays as it is.
migrate_9() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && grep -q "</keyboard>" "$f" || return 0
    grep -q 'key="W-c"' "$f" || sed -i 's#</keyboard>#    <keybind key="W-c"><action name="Execute" command="noctalia msg panel-toggle mabox/colors:picker"/></keybind>\n  </keyboard>#' "$f"
    grep -q 'key="C-W-c"' "$f" || sed -i 's#</keyboard>#    <keybind key="C-W-c"><action name="Execute" command="mb-pinned colors"/></keybind>\n  </keyboard>#' "$f"
    labwc --reconfigure >/dev/null 2>&1 || true
}

# The Equalizer panel needs eq.conf in the user's pipewire config; it loads at the next PipeWire start.
migrate_10() {
    local src=/usr/share/mabox-noctalia-ce/pipewire/eq.conf dst=${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/eq.conf
    [[ -f $src && ! -e $dst ]] || return 0
    install -Dm644 "$src" "$dst"
}

# W-A-q opens the Equalizer panel; a key the user already bound stays as it is.
migrate_11() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && ! grep -q 'key="W-A-q"' "$f" && grep -q "</keyboard>" "$f" || return 0
    sed -i 's#</keyboard>#    <keybind key="W-A-q"><action name="Execute" command="noctalia msg panel-toggle mabox/equalizer:main"/></keybind>\n  </keyboard>#' "$f"
    labwc --reconfigure >/dev/null 2>&1 || true
}

applied=$(cat "$stamp" 2>/dev/null || echo 0)
last=$(compgen -A function migrate_ | wc -l)
for ((n = applied + 1; n <= last; n++)); do "migrate_$n"; done
mkdir -p "${stamp%/*}"
echo "$last" > "$stamp"
