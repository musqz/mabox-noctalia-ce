#!/usr/bin/env bash
# One-time fixes for config files that were copied from an older release.
# Add a migrate_N function per change; the last applied N is kept in the state dir.
set -euo pipefail

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
stamp=$state_home/mabox-noctalia-ce/config-version
files=("${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/config.toml" "$state_home/noctalia/settings.toml")

# Exact-string replace: a value the user changed no longer matches and stays.
replace() {
    local f c
    for f in "${files[@]}"; do
        [[ -f $f ]] || continue
        c=$(<"$f")
        printf '%s\n' "${c//"$1"/"$2"}" > "$f"
    done
}

migrate_1() { replace 'exec mb-updates-ce menu' 'exec noctalia msg panel-toggle mabox/status:updates'; }
migrate_2() {
    local f=${files[0]}
    [[ -f $f ]] || return 0
    grep -q '^\[theme\.templates\.user\.mabox-logo\]' "$f" && return 0
    cat >> "$f" <<'TOML'

[theme.templates.user.mabox-logo]
input_path = "~/.config/noctalia/templates/mabox-logo.svg"
output_path = "~/.local/share/mabox-noctalia-ce/mabox-logo.svg"
TOML
}

# Add the cava keybind and window rule; an existing one is the user's and stays.
migrate_3() {
    local f=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/rc.xml
    [[ -f $f ]] && ! grep -q cava-transparent "$f" || return 0
    grep -q "</keyboard>" "$f" && grep -q "</windowRules>" "$f" || return 0
    sed -i 's#</keyboard>#    <keybind key="C-A-v" name.action="Execute" command.action="jumpapp -m -c cava-transparent mb-cava"/>\n  </keyboard>#' "$f"
    sed -i 's#</windowRules>#    <windowRule identifier="cava-transparent">\n      <action name="SetDecorations" decorations="none"/>\n      <action name="AutoPlace" policy="center"/>\n      <action name="MoveToEdge" direction="down" snapWindows="no"/>\n    </windowRule>\n  </windowRules>#' "$f"
}

# Cava follows the wallpaper colors through a Noctalia template (mb-cava-theme is its hook); add the config block once the template is in place.
migrate_4() {
    local f=${files[0]}
    local tpl=${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/templates/cava-palette
    [[ -f $f && -e $tpl ]] || return 0
    grep -q '^\[theme\.templates\.user\.cava\]' "$f" && return 0
    cat >> "$f" <<'TOML'

[theme.templates.user.cava]
input_path = "~/.config/noctalia/templates/cava-palette"
output_path = "~/.cache/mabox-noctalia-ce/cava-palette"
post_hook = "mb-cava-theme"
TOML
}

applied=$(cat "$stamp" 2>/dev/null || echo 0)
last=$(compgen -A function migrate_ | wc -l)
for ((n = applied + 1; n <= last; n++)); do "migrate_$n"; done
mkdir -p "${stamp%/*}"
echo "$last" > "$stamp"
