#!/usr/bin/env bash

CONF_FILE="$HOME/.config/mabox/mb-gifmaker.conf"

mkdir -p "$HOME/Pictures/Mabox-Animations" "${CONF_FILE%/*}"

if [ ! -f "$CONF_FILE" ]; then
cat << EOF > "$CONF_FILE"
# Largest output size; frames are only shrunk, never stretched or enlarged
width=1280
height=720
# Frames per second
fps=1
# Png location
screenshot_dir=~/Pictures/shot_interval/
# Output dir
output_dir=~/Pictures/Mabox-Animations/
# Quality (1-100)
quality=100

#   1024x768     #   960x720
#   928x696      #   896x672
#   1024x576     #   960x600
#   960x540      #   800x600
#   864x486      #   700x525
#   800x450      #   640x512
#   700x450      #   640x480
#   720x405      #   684x384
#   640x400      #   512x384
#   512x288      #   480x270
#   432x243
EOF
fi

source "$CONF_FILE"

# -s N: longest side in pixels (0 = original size); overrides width and height.
while getopts s: opt; do
    case $opt in
        s) [[ $OPTARG =~ ^[0-9]+$ ]] || { echo "usage: mb-gifmaker [-s PIXELS]" >&2; exit 2; }
           width=$OPTARG; height=$OPTARG ;;
        *) exit 2 ;;
    esac
done

output_file="${output_dir}/mabox-animation-$(date +"%H-%M-%S").gif"
mkdir -p "$output_dir"
basename="$(basename "$output_file")"

shopt -s nullglob
frames=("$screenshot_dir"/*.png)
if (( ${#frames[@]} == 0 )); then
    echo "No images found in $screenshot_dir. Aborting."
    notify-send "No Images ..." "found in $screenshot_dir."
    exit 1
fi

# Normalize all frames to the same dimensions with magick.
# gifski requires every input frame to be identical in size; selected-area
# captures can vary by a pixel or two, which causes the "wrong size" error.
TMPFRAMES=$(mktemp -d)
trap 'rm -rf "$TMPFRAMES"' EXIT

notify-send -t 500000 -i gif "Gif process running" "patience ..."

# Size of the first frame, scaled down to fit width x height; all frames follow it.
first=${frames[0]}
if [ "$width" -gt 0 ] && [ "$height" -gt 0 ]; then
    target=$(magick "$first" -resize "${width}x${height}>" -format '%wx%h' info: 2>/dev/null)
else
    target=$(magick "$first" -format '%wx%h' info: 2>/dev/null)
fi

i=0
for img in "${frames[@]}"; do
    printf -v num "%05d" $i
    magick "$img" -filter Lanczos -resize "${target}!" "$TMPFRAMES/frame_${num}.png"
    (( i++ ))
done

/usr/bin/gifski \
    --quality "$quality" \
    --fps     "$fps"     \
    --width   "${target%x*}" \
    --repeat  0          \
    -o "$output_file"    \
    "$TMPFRAMES"/frame_*.png

if [ $? -eq 0 ]; then
    echo "GIF creation completed successfully."
    notify-send -t 3000 "GIF creation complete" "Created $basename."
    xdg-open "$output_file"
else
    echo "GIF creation failed."
    notify-send -t 3000 -i error "GIF creation failed" "There was an error creating the GIF."
fi
