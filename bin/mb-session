#!/usr/bin/env python3
"""mb-session - desktop sessions: a named set of applications on one or more labwc workspaces.

  mb-session list                       name, workspace, app count (TSV)
  mb-session show NAME
  mb-session capture                    app_id, command (TSV) of the open windows
  mb-session baseline                   remember the open windows for save --new-only
  mb-session save NAME [--new-only] [--workspace N|N-M]
  mb-session remove NAME APP_ID         drop an app (all its windows) from a session
  mb-session rename OLD NEW
  mb-session delete NAME
  mb-session start NAME [--replace]     go to the workspace, start the missing apps;
                                        --replace saves the session you are in, closes every window first
  mb-session switch NAME                go to the workspace only
  mb-session current                    number of the active workspace
  mb-session stop NAME                  close the windows of the session apps
  mb-session menu                       labwc pipe menu
  mb-session login [on|off]             show or set: open the Sessions panel at login
  mb-session login-run                  autostart: open the panel when login is on

Sessions: ~/.config/mabox-noctalia-ce/sessions/NAME.session, first line
"# workspace N", then "app_id<TAB>command". start skips an app whose window is
open on any workspace (labwc does not say which one). The workspace is reached with the
W-A-C-F<N> binds of rc.xml (GoToDesktop), pressed with wtype.
"""
import csv
import os
import re
import shlex
import subprocess
import sys
import time
from xml.sax.saxutils import quoteattr

HOME = os.environ["HOME"]
DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "mabox-noctalia-ce", "sessions")
HERE = os.path.dirname(os.path.realpath(__file__))
LIST_PATHS = (os.path.join(HERE, "..", "lists", "session-apps.csv"), "/usr/share/mabox-noctalia-ce/session-apps.csv")
APP_DIRS = ("/usr/share/applications", HOME + "/.local/share/applications",
            "/var/lib/flatpak/exports/share/applications", HOME + "/.local/share/flatpak/exports/share/applications")
BASELINE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mb-session-baseline")
NAME_RE = re.compile(r"^[A-Za-z0-9 _-]+$")
SKIP = ("noctalia", "q-term-")


def workspace_count():
    try:
        with open(os.path.join(os.path.dirname(DIR), "rc.xml")) as f:
            m = re.search(r'<desktops\s+number="(\d+)"', f.read())
        return min(int(m.group(1)), 6) if m else 4
    except OSError:
        return 4


def die(msg):
    print("mb-session: " + msg, file=sys.stderr)
    sys.exit(1)


def windows(all_windows=False):
    """App ids of the open windows in list order, each once unless all_windows."""
    try:
        out = subprocess.run(["wlrctl", "toplevel", "list"], capture_output=True, text=True).stdout
    except OSError:
        die("wlrctl is not installed")
    ids = []
    for line in out.splitlines():
        app_id, _, title = line.partition(": ")
        app_id = app_id.strip()
        if title.startswith("q-term-"):  # the quake terminals have the terminal's app id
            continue
        if app_id and (all_windows or app_id not in ids) and not app_id.lower().startswith(SKIP):
            ids.append(app_id)
    return ids


def overrides():
    for p in LIST_PATHS:
        if os.path.isfile(p):
            with open(p, newline="") as f:
                rows = csv.reader(r for r in f if not r.startswith("#"))
                return {r[0].lower(): r[1] for r in rows if len(r) >= 2}
    return {}


def desktop_exec(app_id):
    want = app_id.lower()
    for d in APP_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".desktop"):
                continue
            wm = exe = None
            in_entry = False
            with open(os.path.join(d, n), errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("["):
                        in_entry = line == "[Desktop Entry]"
                    elif in_entry and line.startswith("StartupWMClass="):
                        wm = line[15:]
                    elif in_entry and line.startswith("Exec=") and exe is None:
                        exe = line[5:]
            if exe and want in ((wm or "").lower(), n[:-8].lower()):
                return re.sub(r"\s*%[A-Za-z]", "", exe.replace("%%", "%")).strip()
    return None


def running_cmdlines(exe):
    """Command lines (with arguments) of the processes of this executable, oldest first."""
    found = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            with open(f"/proc/{pid}/stat") as f:
                start = int(f.read().rsplit(")", 1)[1].split()[19])
        except (OSError, ValueError, IndexError):
            continue
        if len(argv) < 2 or os.path.basename(argv[0]) != exe:
            continue
        if any(a.startswith("--type=") or a == "-contentproc" for a in argv):
            continue
        found.append((start, shlex.join([exe] + argv[1:])))
    return [c for _, c in sorted(found)]


def commands_for(app_id, count, notes, skip=0):
    """One command per window: the running command lines first, else the base command."""
    base = overrides().get(app_id.lower()) or desktop_exec(app_id)
    if not base:
        notes.append(f"no command known for {app_id}, skipped")
        return []
    try:
        argv = [a for a in shlex.split(base) if a != "env" and "=" not in a.split("/")[0]]
        running = running_cmdlines(os.path.basename(argv[0]))
    except (ValueError, IndexError):
        running = []
    return [(running[i] if i < len(running) else base) for i in range(skip, skip + count)]


def capture(before=None):
    """One row per window; with before (the baseline ids) only the windows beyond those."""
    notes, rows = [], []
    now = windows(True)
    for app_id in windows():
        skip = before.count(app_id) if before is not None else 0
        rows += [(app_id, c) for c in commands_for(app_id, now.count(app_id) - skip, notes, skip)]
    for n in notes:
        print(n, file=sys.stderr)
    return rows


def path(name):
    if not NAME_RE.match(name):
        die("name: letters, digits, space, - and _ only")
    return os.path.join(DIR, name + ".session")


def parse_ws(text):
    """"3" or "3-4" as (first, last)."""
    m = re.fullmatch(r"(\d+)(?:-(\d+))?", text)
    if not m or int(m.group(2) or m.group(1)) < int(m.group(1)):
        die("workspace: N or N-M")
    return int(m.group(1)), int(m.group(2) or m.group(1))


def fmt_ws(ws):
    return str(ws[0]) if ws[0] == ws[1] else f"{ws[0]}-{ws[1]}"


def session_at(ws):
    """Name of the session that owns workspace number ws."""
    return next((n for n in names() if ws and read(n)[0][0] <= ws <= read(n)[0][1]), None)


def read(name):
    p = path(name)
    if not os.path.isfile(p):
        die(f"no session {name}")
    ws, apps = None, []
    with open(p) as f:
        for line in f:
            line = line.rstrip("\n")
            m = re.match(r"# workspace (\d+(?:-\d+)?)$", line)
            if m:
                ws = parse_ws(m.group(1))
            elif line and not line.startswith("#"):
                app_id, _, cmd = line.partition("\t")
                apps.append((app_id, cmd))
    return ws, apps


def write(name, ws, apps):
    os.makedirs(DIR, exist_ok=True)
    with open(path(name), "w") as f:
        f.write(f"# workspace {fmt_ws(ws)}\n")
        for app_id, cmd in apps:
            f.write(f"{app_id}\t{cmd}\n")


def names():
    try:
        return sorted(n[:-8] for n in os.listdir(DIR) if n.endswith(".session"))
    except OSError:
        return []


def used_workspaces(skip=None):
    return {w for n in names() if n != skip for w in range(read(n)[0][0], read(n)[0][1] + 1)}


def switch(ws):
    if not ws:
        return
    try:
        subprocess.run(["wtype", "-M", "logo", "-M", "alt", "-M", "ctrl", "-k", f"F{ws[0]}",
                        "-m", "ctrl", "-m", "alt", "-m", "logo"], check=False)
    except OSError:
        die("wtype is not installed")


def cmd_save(argv):
    if not argv:
        die("save NAME [--new-only] [--workspace N|N-M]")
    name, new_only, ws = argv[0], "--new-only" in argv, None
    if "--workspace" in argv:
        try:
            ws = parse_ws(argv[argv.index("--workspace") + 1])
        except IndexError:
            die("--workspace needs a number")
    only = None
    if new_only:
        try:
            with open(BASELINE) as f:
                only = f.read().split()
        except OSError:
            die("no baseline, run baseline first")
    old = read(name)[0] if os.path.isfile(path(name)) else None
    ws = old if ws is None else ws
    taken = used_workspaces(skip=name)
    top = workspace_count()
    if ws is None:
        free = next((n for n in range(1, top + 1) if n not in taken), None)
        if free is None:
            die("every workspace has a session")
        ws = (free, free)
    if ws[0] < 1 or ws[1] > top:
        die(f"workspace 1-{top}")
    if taken & set(range(ws[0], ws[1] + 1)):
        die(f"workspace {fmt_ws(ws)} overlaps another session")
    apps = capture(only)
    if not apps:
        die("no applications to save")
    write(name, ws, apps)


def close_all():
    for app_id in windows():
        subprocess.run(["wlrctl", "toplevel", "close", "app_id:" + app_id], check=False)
    for _ in range(20):  # windows that ask to save stay open
        if not windows():
            return
        time.sleep(0.5)


def cmd_start(name, replace=False):
    ws, apps = read(name)
    if replace:
        old = session_at(current_workspace())
        if old:
            rows = capture()
            if rows:
                write(old, read(old)[0], rows)
        close_all()
    switch(ws)
    time.sleep(0.5)
    open_now = [w.lower() for w in windows(True)]
    wait = float(os.environ.get("MB_SESSION_WAIT", "1"))
    seen = {}
    for app_id, cmd in apps:
        # one line per window: start only the windows that are missing
        seen[app_id.lower()] = seen.get(app_id.lower(), 0) + 1
        if seen[app_id.lower()] <= open_now.count(app_id.lower()):
            continue
        try:
            subprocess.Popen(shlex.split(cmd), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except (OSError, ValueError) as e:
            print(f"mb-session: {app_id}: {e}", file=sys.stderr)
            continue
        time.sleep(wait)


def current_workspace():
    """Active workspace number from the ext-workspace protocol (labwc); None when it cannot be read."""
    if os.environ.get("MB_SESSION_WORKSPACE"):  # tests
        return int(os.environ["MB_SESSION_WORKSPACE"])
    try:
        from pywayland.client import Display
        from pywayland.protocol.ext_workspace_v1 import ExtWorkspaceManagerV1
        display = Display()
        display.connect()
    except Exception:
        return None
    spaces = []

    def on_workspace(_mgr, ws):
        ws.info = {"state": 0}
        ws.dispatcher["state"] = lambda o, st: o.info.__setitem__("state", st)
        spaces.append(ws)

    def on_global(reg, name, iface, ver):
        if iface == "ext_workspace_manager_v1":
            mgr = reg.bind(name, ExtWorkspaceManagerV1, 1)
            mgr.dispatcher["workspace"] = on_workspace

    display.get_registry().dispatcher["global"] = on_global
    for _ in range(3):
        display.roundtrip()
    active = next((i for i, ws in enumerate(spaces, 1) if ws.info["state"] & 1), None)
    sys.stdout.flush()
    return active


def cmd_stop(name):
    for app_id, _ in read(name)[1]:
        subprocess.run(["wlrctl", "toplevel", "close", "app_id:" + app_id], check=False)


def menu():
    def item(label, command):
        return f"<item label={quoteattr(label)}><action name=\"Execute\" command={quoteattr(command)}/></item>"
    out = ["<openbox_pipe_menu>",
           item("Sessions panel", "noctalia msg panel-toggle mabox/places:sessions")]
    here = current_workspace()
    for n in names():
        mark = "● " if here and session_at(here) == n else ""
        out.append(item(mark + n, f"setsid -f mb-session start {shlex.quote(n)}"))
    out.append("</openbox_pipe_menu>")
    print("\n".join(out))


LOGIN = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "mabox-noctalia-ce", "session-login")


def login(a):
    if a and a[0] in ("on", "off"):
        os.makedirs(os.path.dirname(LOGIN), exist_ok=True)
        if a[0] == "on":
            open(LOGIN, "w").close()
        elif os.path.exists(LOGIN):
            os.remove(LOGIN)
    else:
        print("on" if os.path.exists(LOGIN) else "off")


def main(argv):
    if not argv:
        print(__doc__)
        return 0
    c, a = argv[0], argv[1:]
    if c == "list":
        for n in names():
            ws, apps = read(n)
            print(f"{n}\t{fmt_ws(ws)}\t{len(apps)}")
    elif c == "show" and a:
        ws, apps = read(a[0])
        print(f"workspace\t{fmt_ws(ws)}")
        for app_id, cmd in apps:
            print(f"{app_id}\t{cmd}")
    elif c == "capture":
        for app_id, cmd in capture():
            print(f"{app_id}\t{cmd}")
    elif c == "baseline":
        with open(BASELINE, "w") as f:
            f.write("\n".join(windows(True)) + "\n")
    elif c == "save":
        cmd_save(a)
    elif c == "remove" and len(a) == 2:
        ws, apps = read(a[0])
        write(a[0], ws, [r for r in apps if r[0] != a[1]])
    elif c == "rename" and len(a) == 2:
        old, new = path(a[0]), path(a[1])
        if not os.path.isfile(old):
            die(f"no session {a[0]}")
        if os.path.exists(new):
            die(f"session {a[1]} exists")
        os.rename(old, new)
    elif c == "delete" and a:
        p = path(a[0])
        if not os.path.isfile(p):
            die(f"no session {a[0]}")
        os.remove(p)
    elif c == "start" and a:
        cmd_start(a[0], "--replace" in a[1:])
    elif c == "current":
        ws = current_workspace()
        if ws:
            print(ws)
    elif c == "stop" and a:
        cmd_stop(a[0])
    elif c == "menu":
        menu()
    elif c == "login":
        login(a)
    elif c == "login-run":
        if os.path.exists(LOGIN):
            subprocess.run(["noctalia", "msg", "panel-open", "mabox/places:sessions"])
    elif c == "switch" and a:
        switch(read(a[0])[0])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        code = main(sys.argv[1:])
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 1
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(code)  # pywayland crashes in interpreter teardown
