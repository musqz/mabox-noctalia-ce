#!/usr/bin/env python3
"""mb-session - desktop sessions: a named set of applications on one labwc workspace.

  mb-session list                       name, workspace, app count (TSV)
  mb-session show NAME
  mb-session capture                    app_id, command (TSV) of the open windows
  mb-session baseline                   remember the open windows for save --new-only
  mb-session save NAME [--new-only] [--workspace N]
  mb-session remove NAME APP_ID         drop one app from a session
  mb-session rename OLD NEW
  mb-session delete NAME
  mb-session start NAME                 go to the workspace, start the missing apps
  mb-session switch NAME                go to the workspace only

Sessions: ~/.config/mabox-noctalia-ce/sessions/NAME.session, first line
"# workspace N", then "app_id<TAB>command". start skips an app whose window is
open on any workspace (labwc does not say which one). The workspace is reached with the
W-A-C-F<N> binds of rc.xml (GoToDesktop), pressed with wtype.
"""
import csv
import os
import re
import shlex
import subprocess
import sys
import time

HOME = os.environ["HOME"]
DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "mabox-noctalia-ce", "sessions")
HERE = os.path.dirname(os.path.realpath(__file__))
LIST_PATHS = (os.path.join(HERE, "..", "lists", "session-apps.csv"), "/usr/share/mabox-noctalia-ce/session-apps.csv")
APP_DIRS = ("/usr/share/applications", HOME + "/.local/share/applications",
            "/var/lib/flatpak/exports/share/applications", HOME + "/.local/share/flatpak/exports/share/applications")
BASELINE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mb-session-baseline")
NAME_RE = re.compile(r"^[A-Za-z0-9 _-]+$")
SKIP = ("noctalia", "q-term-")


def workspace_count():
    try:
        with open(os.path.join(os.path.dirname(DIR), "rc.xml")) as f:
            m = re.search(r'<desktops\s+number="(\d+)"', f.read())
        return min(int(m.group(1)), 6) if m else 4
    except OSError:
        return 4


def die(msg):
    print("mb-session: " + msg, file=sys.stderr)
    sys.exit(1)


def windows():
    """Unique app ids of the open windows, in list order."""
    try:
        out = subprocess.run(["wlrctl", "toplevel", "list"], capture_output=True, text=True).stdout
    except OSError:
        die("wlrctl is not installed")
    ids = []
    for line in out.splitlines():
        app_id = line.partition(": ")[0].strip()
        if app_id and app_id not in ids and not app_id.lower().startswith(SKIP):
            ids.append(app_id)
    return ids


def overrides():
    for p in LIST_PATHS:
        if os.path.isfile(p):
            with open(p, newline="") as f:
                rows = csv.reader(r for r in f if not r.startswith("#"))
                return {r[0].lower(): r[1] for r in rows if len(r) >= 2}
    return {}


def desktop_exec(app_id):
    want = app_id.lower()
    for d in APP_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".desktop"):
                continue
            wm = exe = None
            in_entry = False
            with open(os.path.join(d, n), errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("["):
                        in_entry = line == "[Desktop Entry]"
                    elif in_entry and line.startswith("StartupWMClass="):
                        wm = line[15:]
                    elif in_entry and line.startswith("Exec=") and exe is None:
                        exe = line[5:]
            if exe and want in ((wm or "").lower(), n[:-8].lower()):
                return re.sub(r"\s*%[A-Za-z]", "", exe.replace("%%", "%")).strip()
    return None


def running_cmdline(exe):
    """Command line of the oldest process of this executable, when it carries arguments."""
    best = None
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            with open(f"/proc/{pid}/stat") as f:
                start = int(f.read().rsplit(")", 1)[1].split()[19])
        except (OSError, ValueError, IndexError):
            continue
        if len(argv) < 2 or os.path.basename(argv[0]) != exe:
            continue
        if any(a.startswith("--type=") or a == "-contentproc" for a in argv):
            continue
        if best is None or start < best[0]:
            best = (start, argv)
    return shlex.join([exe] + best[1][1:]) if best else None


def command_for(app_id, notes):
    base = overrides().get(app_id.lower()) or desktop_exec(app_id)
    if not base:
        notes.append(f"no command known for {app_id}, skipped")
        return None
    try:
        argv = [a for a in shlex.split(base) if a != "env" and "=" not in a.split("/")[0]]
        exe = os.path.basename(argv[0])
    except (ValueError, IndexError):
        return base
    return running_cmdline(exe) or base


def capture(only=None):
    notes, rows = [], []
    for app_id in windows():
        if only is not None and app_id in only:
            continue
        cmd = command_for(app_id, notes)
        if cmd:
            rows.append((app_id, cmd))
    for n in notes:
        print(n, file=sys.stderr)
    return rows


def path(name):
    if not NAME_RE.match(name):
        die("name: letters, digits, space, - and _ only")
    return os.path.join(DIR, name + ".session")


def read(name):
    p = path(name)
    if not os.path.isfile(p):
        die(f"no session {name}")
    ws, apps = None, []
    with open(p) as f:
        for line in f:
            line = line.rstrip("\n")
            m = re.match(r"# workspace (\d+)$", line)
            if m:
                ws = int(m.group(1))
            elif line and not line.startswith("#"):
                app_id, _, cmd = line.partition("\t")
                apps.append((app_id, cmd))
    return ws, apps


def write(name, ws, apps):
    os.makedirs(DIR, exist_ok=True)
    with open(path(name), "w") as f:
        f.write(f"# workspace {ws}\n")
        for app_id, cmd in apps:
            f.write(f"{app_id}\t{cmd}\n")


def names():
    try:
        return sorted(n[:-8] for n in os.listdir(DIR) if n.endswith(".session"))
    except OSError:
        return []


def used_workspaces(skip=None):
    return {read(n)[0] for n in names() if n != skip}


def switch(ws):
    if not ws:
        return
    try:
        subprocess.run(["wtype", "-M", "logo", "-M", "alt", "-M", "ctrl", "-k", f"F{ws}",
                        "-m", "ctrl", "-m", "alt", "-m", "logo"], check=False)
    except OSError:
        die("wtype is not installed")


def cmd_save(argv):
    if not argv:
        die("save NAME [--new-only] [--workspace N]")
    name, new_only, ws = argv[0], "--new-only" in argv, None
    if "--workspace" in argv:
        try:
            ws = int(argv[argv.index("--workspace") + 1])
        except (IndexError, ValueError):
            die("--workspace needs a number")
    only = None
    if new_only:
        try:
            with open(BASELINE) as f:
                only = set(f.read().split("\n")) - {""}
        except OSError:
            die("no baseline, run baseline first")
    old = read(name)[0] if os.path.isfile(path(name)) else None
    ws = old if ws is None else ws
    taken = used_workspaces(skip=name)
    top = workspace_count()
    if ws is None:
        ws = next((n for n in range(1, top + 1) if n not in taken), None)
        if ws is None:
            die("every workspace has a session")
    if not 1 <= ws <= top:
        die(f"workspace 1-{top}")
    if ws in taken:
        die(f"workspace {ws} belongs to another session")
    apps = capture(only)
    if not apps:
        die("no applications to save")
    write(name, ws, apps)


def cmd_start(name):
    ws, apps = read(name)
    switch(ws)
    time.sleep(0.5)
    open_ids = {w.lower() for w in windows()}
    wait = float(os.environ.get("MB_SESSION_WAIT", "1"))
    for app_id, cmd in apps:
        if app_id.lower() in open_ids:
            continue
        try:
            subprocess.Popen(shlex.split(cmd), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except (OSError, ValueError) as e:
            print(f"mb-session: {app_id}: {e}", file=sys.stderr)
            continue
        time.sleep(wait)


def main(argv):
    if not argv:
        print(__doc__)
        return 0
    c, a = argv[0], argv[1:]
    if c == "list":
        for n in names():
            ws, apps = read(n)
            print(f"{n}\t{ws}\t{len(apps)}")
    elif c == "show" and a:
        ws, apps = read(a[0])
        print(f"workspace\t{ws}")
        for app_id, cmd in apps:
            print(f"{app_id}\t{cmd}")
    elif c == "capture":
        for app_id, cmd in capture():
            print(f"{app_id}\t{cmd}")
    elif c == "baseline":
        with open(BASELINE, "w") as f:
            f.write("\n".join(windows()) + "\n")
    elif c == "save":
        cmd_save(a)
    elif c == "remove" and len(a) == 2:
        ws, apps = read(a[0])
        write(a[0], ws, [r for r in apps if r[0] != a[1]])
    elif c == "rename" and len(a) == 2:
        old, new = path(a[0]), path(a[1])
        if not os.path.isfile(old):
            die(f"no session {a[0]}")
        if os.path.exists(new):
            die(f"session {a[1]} exists")
        os.rename(old, new)
    elif c == "delete" and a:
        p = path(a[0])
        if not os.path.isfile(p):
            die(f"no session {a[0]}")
        os.remove(p)
    elif c == "start" and a:
        cmd_start(a[0])
    elif c == "switch" and a:
        switch(read(a[0])[0])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
