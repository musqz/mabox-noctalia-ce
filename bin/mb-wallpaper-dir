#!/usr/bin/env bash
# Set the noctalia wallpaper directory and add it to the Wallpaper folders panel list. Used by the pcmanfm action "Set wallpaper dir", the panel and Recolor.
#   mb-wallpaper-dir <directory>
set -euo pipefail

d=${1:-}
[[ -d $d ]] || { notify-send -u critical "Wallpaper dir" "No directory selected." || true; exit 1; }
d=$(readlink -f "$d")

if [[ -z $(find "$d" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.avif' \) -print -quit) ]]; then
    notify-send -u critical -i error "Wallpaper dir" "No images in: $d" || true
    exit 1
fi

val=${d//\\/\\\\}
val=${val//\"/\\\"}
# directory_dark/directory_light override directory for the active theme mode.
for key in directory directory_dark directory_light; do
    if ! noctalia msg config-set "wallpaper.$key" "\"$val\"" >/dev/null; then
        notify-send -u critical -i error "Wallpaper dir" "noctalia rejected the change." || true
        exit 1
    fi
done
# The Wallpaper folders panel (W-A-w) lists the folders in this file; a failure here must not hide the change that was made.
list=${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/plugins/data/mabox/wallpaper-dirs/dirs
{
    mkdir -p "${list%/*}"
    [[ ! -s $list || -z $(tail -c1 "$list") ]] || echo >> "$list"
    grep -qxF -- "$d" "$list" 2>/dev/null || echo "$d" >> "$list"
} || true
noctalia msg wallpaper-random >/dev/null || true
notify-send -i preferences-desktop-wallpaper "Wallpaper dir" "Set to: $d" || true
