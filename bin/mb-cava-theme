#!/usr/bin/env bash
# Write the cava theme "noctalia": gradient_count colors spread over the Noctalia palette.
# Noctalia renders the palette (templates/cava-palette) and runs this as its hook.
# --force builds the theme even when the cava config does not use it yet.
set -euo pipefail

cfg=${XDG_CONFIG_HOME:-$HOME/.config}/cava/config
palette=${XDG_CACHE_HOME:-$HOME/.cache}/mabox-noctalia-ce/cava-palette
theme=${XDG_CONFIG_HOME:-$HOME/.config}/cava/themes/noctalia

# Runs on every wallpaper change; do nothing unless cava follows the theme.
[[ ${1:-} == --force ]] || grep -q "^theme *= *'noctalia'" "$cfg" 2>/dev/null || exit 0

[[ -f $palette ]] || { echo "mb-cava-theme: $palette not found" >&2; exit 1; }
command -v pastel >/dev/null || { echo "mb-cava-theme: pastel is not installed" >&2; exit 1; }

n=$(sed -n -E 's/^gradient_count *= *([0-9]+).*/\1/p' "$cfg" 2>/dev/null | head -n1)
n=${n:-3}
((n < 2)) && n=2
((n > 8)) && n=8

mapfile -t base < <(grep -E '^#[0-9a-fA-F]{6}$' "$palette")
((${#base[@]} >= 2)) || { echo "mb-cava-theme: no colors in $palette" >&2; exit 1; }

mkdir -p "$(dirname "$theme")"
raw=$(pastel gradient -n "$n" "${base[@]}" | pastel format hex)
[[ $(wc -w <<<"$raw") -eq $n ]] || { echo "mb-cava-theme: pastel did not return $n colors" >&2; exit 1; }

# The palette colors are close pastels. A saturation boost and a lightness ramp (darker at the bottom) keep the steps visible.
colors=
i=0
for c in $raw; do
    l=$(awk -v i="$i" -v n="$n" 'BEGIN { printf "%.3f", 0.55 + 0.2 * i / (n - 1) }')
    colors+="$(pastel color "$c" | pastel saturate 0.3 | pastel set hsl-lightness "$l" | pastel format hex) "
    i=$((i + 1))
done

tmp=$(mktemp "$theme.XXXXXX")
{
    echo "[color]"
    echo "gradient = 1"
    echo "gradient_count = $n"
    i=1
    for c in $colors; do
        echo "gradient_color_$i = '$c'"
        i=$((i + 1))
    done
} > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$theme"

pkill -x -USR1 cava || true
