#!/usr/bin/env bash
# Write the cava theme "noctalia": two colors from the Noctalia palette.
# Noctalia renders the palette (templates/cava-palette) and runs this as its hook.
# --force builds the theme even when the cava config does not use it yet.
set -euo pipefail

cfg=${XDG_CONFIG_HOME:-$HOME/.config}/cava/config
palette=${XDG_CACHE_HOME:-$HOME/.cache}/mabox-noctalia-ce/cava-palette
theme=${XDG_CONFIG_HOME:-$HOME/.config}/cava/themes/noctalia

# Runs on every wallpaper change; do nothing unless cava follows the theme.
[[ ${1:-} == --force ]] || grep -q "^theme *= *'noctalia'" "$cfg" 2>/dev/null || exit 0

die() { echo "mb-cava-theme: $1" >&2; exit 1; }

[[ -f $palette ]] || die "$palette not found"
command -v pastel >/dev/null || die "pastel is not installed"

mapfile -t base < <(grep -E '^#[0-9a-fA-F]{6}$' "$palette")
((${#base[@]} >= 2)) || die "no colors in $palette"

# Which two palette colors (pair: pt, ps, st) and how they are tuned (style: vivid, soft, palette).
# The panel writes these to cava-follow; without it the result is primary + tertiary, vivid.
opts=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/cava-follow
pair=$(sed -n 's/^pair=//p' "$opts" 2>/dev/null | tail -1)
style=$(sed -n 's/^style=//p' "$opts" 2>/dev/null | tail -1)

# Palette lines: primary, secondary, tertiary. A two-line palette gives primary and tertiary.
if ((${#base[@]} >= 3)); then
  case $pair in
    ps) lo=${base[0]} hi=${base[1]} ;;
    st) lo=${base[1]} hi=${base[2]} ;;
    *) lo=${base[0]} hi=${base[2]} ;;
  esac
else
  lo=${base[-2]} hi=${base[-1]}
fi

# tone COLOR LIGHTNESS: the palette colors are close pastels, so vivid boosts the saturation and sets the lightness.
tone() {
  case $style in
    palette) pastel color "$1" | pastel format hex ;;
    soft) pastel color "$1" | pastel desaturate 0.15 | pastel set hsl-lightness "$2" | pastel format hex ;;
    *) pastel color "$1" | pastel saturate 0.3 | pastel set hsl-lightness "$2" | pastel format hex ;;
  esac
}
bottom=$(tone "$lo" 0.55) || die "pastel failed"
top=$(tone "$hi" 0.75) || die "pastel failed"
[[ $bottom =~ ^#[0-9a-fA-F]{6}$ && $top =~ ^#[0-9a-fA-F]{6}$ ]] || die "pastel failed"

mkdir -p "$(dirname "$theme")"
tmp=$(mktemp "$theme.XXXXXX")
cat > "$tmp" <<THEME
[color]
gradient = 1
gradient_count = 2
gradient_color_1 = '$bottom'
gradient_color_2 = '$top'
THEME
chmod 644 "$tmp"
mv "$tmp" "$theme"

pkill -x -USR1 cava || true
