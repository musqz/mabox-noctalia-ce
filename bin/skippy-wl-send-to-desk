#!/usr/bin/env bash
# Pick windows with skippy-wl, then send each to the next workspace.
# Needs the labwc bind: <keybind key="W-A-C-0"><action name="SendToDesktop" to="right" wrap="yes"/></keybind>
set -euo pipefail

ids=$(skippy-wl --show --multi-select) || exit 0

while IFS= read -r id; do
    skippy-wl --activate "$id" || continue
    sleep 0.15
    wtype -M logo -M alt -M ctrl -k 0 -m ctrl -m alt -m logo
    sleep 0.15
done <<< "$ids"
