#!/usr/bin/env bash
# Hide the pointer after N seconds without keyboard or mouse input; any input shows it again.
# Playing video and Caffeine do not delay it: the input idle timer ignores idle inhibitors.
#   mb-hide-cursor            start when enabled (autostart)
#   mb-hide-cursor on [secs]  enable (default: the last value, else 5) and start now
#   mb-hide-cursor off        disable and stop
# Sends F20 once per idle period; rc.xml binds F20 to HideCursor. F20 counts as input
# for Noctalia too: keep N below the screen-off and lock times.
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/mabox-noctalia-ce/hide-cursor
run=${XDG_RUNTIME_DIR:-/tmp}
flag=$run/mb-hide-cursor.flag
now() { date +%s%N; }

state=off secs=5
[[ -f $conf ]] && read -r state secs < "$conf" || true

stop() {
    pkill -f '[m]b-hide-cursor-watch' || true
    rm -f "$flag"
}

case ${1:-} in
fire)
    # Our own F20 restarts the timer, so the next fire comes secs after ours;
    # a later one means real input came in between and the pointer is visible again.
    [[ -e $flag ]] && (($(now) - $(<"$flag") < (secs + 1) * 1000000000)) && exit 0
    now > "$flag"
    exec wtype -k F20
    ;;
resume)
    # Our own F20 resumes the idle state within a few ms; ignore that one.
    [[ -e $flag ]] && (($(now) - $(<"$flag") > 500000000)) && rm -f "$flag"
    exit 0
    ;;
off)
    mkdir -p "${conf%/*}"
    echo "off $secs" > "$conf"
    stop
    exit 0
    ;;
on)
    secs=${2:-$secs}
    [[ $secs =~ ^[0-9]+$ && $secs -ge 1 ]] || { echo "mb-hide-cursor: seconds must be a number" >&2; exit 2; }
    mkdir -p "${conf%/*}"
    echo "on $secs" > "$conf"
    stop
    setsid -f "$0" >/dev/null 2>&1
    exit 0
    ;;
esac

[[ $state == on ]] || exit 0
self=$(readlink -f "$0")
stop
exec -a mb-hide-cursor-watch python3 -I - "$secs" "$self" <<'PY'
import os, subprocess, sys
from pywayland.client import Display
from pywayland.protocol.wayland import WlSeat
from pywayland.protocol.ext_idle_notify_v1 import ExtIdleNotifierV1

secs, me = int(sys.argv[1]), sys.argv[2]
display = Display()
display.connect()
found = {}


def on_global(reg, name, iface, ver):
    if iface == "ext_idle_notifier_v1" and ver >= 2:
        found["notifier"] = reg.bind(name, ExtIdleNotifierV1, 2)
    elif iface == "wl_seat" and "seat" not in found:
        found["seat"] = reg.bind(name, WlSeat, 1)


display.get_registry().dispatcher["global"] = on_global
display.roundtrip()
if "notifier" not in found or "seat" not in found:
    print("mb-hide-cursor: the compositor has no input idle timer", file=sys.stderr)
    os._exit(1)
note = found["notifier"].get_input_idle_notification(secs * 1000, found["seat"])
note.dispatcher["idled"] = lambda _n: subprocess.run([me, "fire"], check=False)
note.dispatcher["resumed"] = lambda _n: subprocess.run([me, "resume"], check=False)
while display.dispatch(block=True) != -1:
    pass
os._exit(0)  # pywayland crashes in interpreter teardown
PY
