#!/usr/bin/env bash
# Turn the updates bar button into a disc warning when a disc is at or over the alert level of the mabox/status plugin.
set -euo pipefail

conf="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/plugins/data/mabox/status/settings"
limit=90
warn='#ff9800'
if [[ -f $conf ]]; then
    v=$(sed -n 's/^disk_limit=//p' "$conf"); [[ $v =~ ^[0-9]+$ ]] && limit=$v
    v=$(sed -n 's/^warn=//p' "$conf"); [[ $v =~ ^#[0-9a-fA-F]{6}$ ]] && warn=$v
fi

full=""
if ((limit > 0)); then
    full=$(df -h --output=source,pcent,target | awk -v lim="$limit" '
        NR > 1 && $1 ~ /^\/dev\// && $1 !~ /loop/ && $3 !~ /^\/(boot|run)/ && !seen[$1]++ {
            p = $2; sub(/%/, "", p)
            m = $0; sub(/^[^ ]+ +[^ ]+ +/, "", m)
            if (p + 0 >= lim) printf "%s %s%%; ", m, p
        }')
fi

# mb-updates-ce draws the button; it reads this file (color, then text).
set_bar() {
    local f="${XDG_RUNTIME_DIR:-/tmp}/mb-status-warn.full" new=""
    [[ -n $1 ]] && new=$(printf '%s\n%s' "$1" "$2")
    if [[ -z $new ]]; then
        [[ -f $f ]] || return 0
    else
        [[ -f $f && $(<"$f") == "$new" ]] && return 0
    fi
    if [[ -n $new ]]; then printf '%s' "$new" > "$f"; else rm -f "$f"; fi
    mb-updates-ce repaint || { rm -f "$f"; echo "mb-status-warn: repaint failed" >&2; }
}

# One notification per change of the full-disc list; "Snooze" mutes it for 24 h. The bar button is not muted.
notify_full() {
    local run="${XDG_RUNTIME_DIR:-/tmp}" snooze=0
    [[ -f $run/mb-status-warn.snooze ]] && snooze=$(<"$run/mb-status-warn.snooze")
    [[ $snooze =~ ^[0-9]+$ ]] || snooze=0
    ((EPOCHSECONDS < snooze)) && return 0
    # keyed on the mount points, so growing percentages do not notify again
    local key
    key=$(sed 's/ [0-9]*%//g' <<<"$1")
    [[ -f $run/mb-status-warn.notified && $(<"$run/mb-status-warn.notified") == "$key" ]] && return 0
    printf '%s' "$key" > "$run/mb-status-warn.notified"
    if command -v notify-send.sh >/dev/null; then
        setsid -f notify-send.sh -u critical -t 0 -a "Disc space" -i drive-harddisk \
            -R "$run/mb-status-warn.id" \
            -d "noctalia msg panel-open mabox/status:main" \
            -o "Open status:noctalia msg panel-open mabox/status:main" \
            -o "Snooze 24 h:sh -c 'echo \$((\$(date +%s) + 86400)) > $run/mb-status-warn.snooze'" \
            "Disc almost full" "$1" >/dev/null 2>&1
    else
        notify-send -u critical -a "Disc space" -i drive-harddisk "Disc almost full" "$1"
    fi
}

full=${full//[\"\\&<>]/}
if [[ -n $full ]]; then
    set_bar "$warn" "disc full: ${full%; }"
    notify_full "${full%; }"
else
    set_bar "" ""
    run="${XDG_RUNTIME_DIR:-/tmp}"
    if [[ -f $run/mb-status-warn.id ]] && command -v notify-send.sh >/dev/null; then
        notify-send.sh -s "$(<"$run/mb-status-warn.id")" >/dev/null 2>&1 || true
    fi
    rm -f "$run/mb-status-warn.notified" "$run/mb-status-warn.snooze" "$run/mb-status-warn.id"
fi
