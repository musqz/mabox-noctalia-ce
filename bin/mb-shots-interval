#!/usr/bin/env bash
# Toggle interval screenshots with grim; run again to stop.
#   mb-shots-interval [-o OUTPUT|auto | -a] [SECONDS]
#   mb-shots-interval -s | -n | -b | -x     count the images / move them to backup/DATE / delete them
# -o: one monitor (auto = SCREENSHOT_OUTPUT, the only monitor, or a click on one of several), -a: select an area once.
# Without either option all monitors are captured into one image.
# Config: ~/.config/mabox/mb-interval-shots.conf (interval=, screenshot_dir=).
set -euo pipefail

conf=${XDG_CONFIG_HOME:-$HOME/.config}/mabox/mb-interval-shots.conf
pidfile=${XDG_RUNTIME_DIR:-/tmp}/mb-shots-interval.pid

load_conf() {
    interval=5
    dir=$HOME/Pictures/shot_interval
    if [[ -f $conf ]]; then
        v=$(sed -n 's/^interval=//p' "$conf" | tail -n1)
        [[ $v =~ ^[0-9]+$ ]] && interval=$v
        v=$(sed -n 's/^screenshot_dir=//p' "$conf" | tail -n1)
        v=${v//\"/}
        [[ -n $v ]] && dir=${v/#\~/$HOME}
    fi
    return 0
}

running() { [[ -f $pidfile ]] && grep -qa mb-shots-interval "/proc/$(<"$pidfile")/cmdline" 2>/dev/null; }

case ${1-} in
    -s) if running; then kill "$(<"$pidfile")"; rm -f "$pidfile"; fi; exit 0 ;;
    -n) load_conf; shopt -s nullglob; files=("$dir"/*.png); echo "${#files[@]}"; exit 0 ;;
    -b|-x)
        running && { echo "interval screenshots are running" >&2; exit 1; }
        load_conf
        shopt -s nullglob
        files=("$dir"/*.png)
        (( ${#files[@]} )) || exit 0
        if [[ $1 == -b ]]; then
            dest=$dir/backup/$(date +%Y%m%d-%H%M%S)
            mkdir -p "$dest"
            mv -- "${files[@]}" "$dest"/
        else
            rm -f -- "${files[@]}"
        fi
        exit 0 ;;
esac

if running; then
    kill "$(<"$pidfile")"
    rm -f "$pidfile"
    exit 0
fi

output= area=
while getopts o:a opt; do
    case $opt in
        o) output=$OPTARG ;;
        a) area=1 ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))
# auto: SCREENSHOT_OUTPUT, the only enabled monitor, or a click on one of several (slurp -o)
slurp_args=()
if [[ $output == auto ]]; then
    output=${SCREENSHOT_OUTPUT:-}
    if [[ -z $output ]]; then
        outs=$(wlr-randr | awk '/^[^ ]/{n=$1} /Enabled: yes/{print n}')
        if [[ -n $outs && $(grep -c . <<< "$outs") -eq 1 ]]; then output=$outs; else slurp_args=(-o); fi
    fi
fi
args=()
if [[ -n $area || ${#slurp_args[@]} -gt 0 ]]; then
    region=$(slurp "${slurp_args[@]}") || exit 0
    args=(-g "$region")
elif [[ -n $output ]]; then
    args=(-o "$output")
fi

load_conf
[[ ${1-} =~ ^[0-9]+$ && $1 -gt 0 ]] && interval=$1
(( interval > 0 )) || interval=5

mkdir -p "$dir"
echo $$ > "$pidfile"

# The camera button of the bar is a red dot while this runs; a left click stops it.
getcfg() {
    local v
    v=$(noctalia msg config-get "widget.screenrec.$1" 2>/dev/null) || v=
    v=${v#\'}; v=${v%\'}
    printf '%s' "$v"
}
setcfg() { noctalia msg config-set "widget.screenrec.$1" "\"$2\"" >/dev/null || true; }
stop_cmd='exec mb-shots-interval'
tip= gly= act_l=
restore() {
    rm -f "$pidfile"
    kill $(jobs -p) 2>/dev/null || true
    # only undo what this script set; a recording may own the button now
    if [[ $(getcfg tooltip) == "interval:"* ]]; then
        setcfg glyph "${gly:-camera}"
        setcfg color on_surface
        setcfg tooltip "${tip:-L:Area shot R:Panel}"
    fi
    [[ $(getcfg actions.left) == "$stop_cmd" ]] && setcfg actions.left "${act_l:-exec mb-screenshot screenshot-region}"
    return 0
}
trap restore EXIT
tip=$(getcfg tooltip)
[[ $tip == "interval:"* || $tip == "recording:"* || $tip == "paused:"* ]] && tip=
gly=$(getcfg glyph)
[[ $gly == circle-filled || $gly == player-pause ]] && gly=
act_l=$(getcfg actions.left)
[[ $act_l == "$stop_cmd" || $act_l == 'exec screenrec-toggle --stop' ]] && act_l=
setcfg glyph circle-filled
setcfg color error
setcfg tooltip "interval: left click stops"
setcfg actions.left "$stop_cmd"
while true; do
    grim "${args[@]}" "$dir/Shot-$(date +%Y%m%d-%H%M%S).png" || true
    sleep "$interval" & wait $!
done
