pkgbase = mabox-noctalia-ce
	pkgdesc = Mabox labwc + Noctalia session and default configs (CE)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/musqz/mabox-noctalia-ce
	install = mabox-noctalia-ce.install
	arch = any
	license = GPL
	depends = python
	depends = imagemagick
	depends = labwc
	depends = noctalia
	depends = kanshi
	depends = wlr-randr
	depends = wlopm
	depends = wtype
	depends = wlrctl
	depends = grim
	depends = slurp
	depends = yad
	depends = geany
	depends = libnotify
	depends = ddcutil
	depends = terminator
	depends = foot
	depends = conky
	depends = gmrun
	optdepends = kitty: terminal keybind
	optdepends = pavucontrol: volume control keybind
	optdepends = viewnior: screenshot viewer keybind
	optdepends = fittsmon: provides fittsmon-wl (github.com/musqz/fittsmon)
	optdepends = fittsmon-wl-gui: fittsmon-wl config GUI (github.com/musqz/fittsmon-wl-gui)
	optdepends = skippy-wl: window switcher keybinds (github.com/musqz/skippy-wl)
	optdepends = jumpapp-ng: app launch/focus keybinds (AUR)
	optdepends = wl-screenrec: screen recording keybind (AUR)
	optdepends = ffmpeg: converter menu
	optdepends = gifski: converter GIF output
	optdepends = swaylock-effects: lock screen (AUR)
	optdepends = beautysolar-icon-theme: default icon theme
	optdepends = tabdock: Firefox tab panel autostart (github.com/musqz/tabdock)
	optdepends = pyradio: PyRadio theme template
	optdepends = pywalfox: Firefox theme template

pkgname = mabox-noctalia-ce
