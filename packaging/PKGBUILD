# Maintainer: musqz
pkgname=mabox-noctalia-ce
pkgver=0.4.7
pkgrel=1
pkgdesc='Mabox labwc + Noctalia session and default configs (CE)'
arch=('any')
url='https://github.com/musqz/mabox-noctalia-ce'
license=('GPL')
depends=('python' 'python-gobject' 'python-cairo' 'gtk3' 'gtk-layer-shell' 'imagemagick' 'labwc' 'noctalia' 'kanshi' 'wlr-randr' 'wlopm' 'wtype' 'wlrctl' 'grim' 'slurp' 'yad'
         'geany' 'libnotify' 'ddcutil' 'terminator' 'foot' 'pacman-contrib' 'gmrun' 'qt6ct' 'nwg-look' 'jq')
optdepends=('pastel: wallpaper colors for the Cava panel (mb-cava-theme)'
            'mabox-colorizer: cavactl for the Cava panel'
            'cava: audio visualizer (mb-cava); the C-A-v key also needs jumpapp-ng'
            'mabox-snapshot: build an ISO from the Snapshot panel'
            'mabox-persistence-usb: write an ISO to a USB stick from the Snapshot panel'
            'quickbox-qt>=1.4: start an ISO in a VM from the Snapshot panel (mb-iso-next)'
            'radicale: local calendar (mb-calendar-setup)'
            'inxi: hardware tab of the System panel'
            'fastfetch: system summary button in the System panel'
            'kitty: terminal keybind'
            'pavucontrol: volume control keybind'
            'viewnior: screenshot viewer keybind'
            'fittsmon: provides fittsmon-wl (github.com/musqz/fittsmon)'
            'fittsmon-wl-gui: fittsmon-wl config GUI (github.com/musqz/fittsmon-wl-gui)'
            'skippy-wl: window switcher keybinds (github.com/musqz/skippy-wl)'
            'pamac-gtk3: Add/Remove software in the root menu'
            'jumpapp-ng: app launch/focus keybinds (AUR)'
            'wl-screenrec: screen recording keybind (AUR)'
            'ffmpeg: converter menu'
            'gifski: converter GIF output'
            'colormenu: Built-in palettes for the Colors panel, colors shared with the Openbox session'
            'wl-clipboard: paste-ready note copy and music URLs'
            'labwc-menu-generator-git: Applications menu (AUR)'
            'beautysolar-icon-theme: default icon theme'
            'tabdock: Firefox tab panel autostart (github.com/musqz/tabdock)'
            'pyradio: PyRadio theme template'
            'python-pywalfox: Firefox theme template')
install=mabox-noctalia-ce.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1410d1892c42c5b6e0f0d0251881b7f73b31b2ec1b1457e0d84d73a8e14a5b21')

package() {
  local root="$srcdir/$pkgname-$pkgver"

  install -Dm755 "$root/lib/mabox-noctalia-ce" "$pkgdir/usr/bin/mabox-noctalia-ce"
  install -Dm755 "$root"/bin/* -t "$pkgdir/usr/bin"
  install -Dm644 "$root/lists/keys.csv" -t "$pkgdir/usr/share/mabox-noctalia-ce"
  install -Dm644 "$root/lists/keys-profiles.csv" -t "$pkgdir/usr/share/mabox-noctalia-ce"
  install -Dm644 "$root"/lists/appkeys/*.csv -t "$pkgdir/usr/share/mabox-noctalia-ce/appkeys"
  install -Dm644 "$root"/systemd/user/* -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 "$root/configs/backgrounds/noctalia-wallpaper.jpg" -t "$pkgdir/usr/share/backgrounds"
  install -Dm644 "$root"/configs/file-manager/actions/* -t "$pkgdir/usr/share/file-manager/actions"
  install -Dm644 "$root/configs/noctalia-ce.desktop" \
    "$pkgdir/usr/share/wayland-sessions/noctalia-ce.desktop"

  local skel="$pkgdir/etc/skel/.config"
  install -dm755 "$skel"
  cp -r "$root/configs/mabox-noctalia-ce" "$skel/"
  chmod 755 "$skel"/mabox-noctalia-ce/autostart
  rm -rf "$skel"/mabox-noctalia-ce/plugins

  install -dm755 "$pkgdir/usr/share/mabox-noctalia-ce"
  cp -r "$root/configs/noctalia" "$pkgdir/usr/share/mabox-noctalia-ce/"
  cp -r "$root/configs/mabox-noctalia-ce/plugins" "$pkgdir/usr/share/mabox-noctalia-ce/"
  find "$skel" -name "*.png" -exec chmod 644 {} +
}
