conky.config = {
	out_to_x = true,
	out_to_wayland = false,
-- WINDOW
    own_window = true,
    own_window_type = 'desktop',
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour = '#00000000',
    own_window_class = 'Conky-nobg',
    own_window_title = 'Mabox Polaroid Widget',
    
    alignment = 'bottom_right',
    gap_x = 1950,
    gap_y = 60,
    minimum_width = 333,
    minimum_height = 280,

-- MISC
-- Boolean value, if true, Conky will be forked to background when started.
    background = true,
    use_spacer = 'none',
    no_buffers = true,

-- Imlib2 image cache size, in bytes. Default 4MiB Increase this value if you use
-- $image lots. Set to 0 to disable the image cache.
    imlib_cache_size = 10,
    double_buffer = true,
    update_interval = 1,
};

conky.text = [[
${execpi 30 ~/.config/mabox-noctalia/menuscripts/polaroid}
${image ~/.config/mabox-noctalia/conky/images/punaise.png -p 103,0 -s 96x96}
]];


