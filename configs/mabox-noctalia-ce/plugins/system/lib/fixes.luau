--!nonstrict
-- Quick fixes: topic (a filter button), keywords (extra search words), when to use, what it does, a read-only check and the command run in a terminal.
-- arch_fix replaces fix when pacman-mirrors is missing (plain Arch).
return {
  {
    title = "Update is blocked: unable to lock database",
    topic = "Packages",
    keywords = "pacman db.lck lock stuck blocked update installer",
    when = "pacman or the updater says the database is locked, but nothing is updating.",
    how = "Removes the lock file left by an interrupted update, only when no pacman is running.",
    check = [==[pgrep -a pacman || echo 'no pacman running'; ls -l /var/lib/pacman/db.lck 2>/dev/null || echo 'no lock file']==],
    fix = [==[pgrep -x pacman && echo 'pacman is still running, wait for it' || sudo rm -f /var/lib/pacman/db.lck]==],
  },
  {
    title = "Signature or keyring errors during update",
    topic = "Packages",
    keywords = "pgp signature key gpg trust corrupted invalid package keyring",
    when = "invalid or corrupted package (PGP signature), or unknown trust.",
    how = "Updates the keyrings, refreshes the trusted keys, then updates.",
    fix = [==[sudo pacman -Sy --needed archlinux-keyring manjaro-keyring && sudo pacman-key --populate archlinux manjaro && sudo pacman -Su]==],
    arch_fix = [==[sudo pacman -Sy --needed archlinux-keyring && sudo pacman-key --populate archlinux && sudo pacman -Su]==],
  },
  {
    title = "Downloads are slow or mirrors fail",
    topic = "Packages",
    keywords = "mirror slow download 404 timeout retrieving file",
    when = "failed retrieving file, 404 errors, or very slow updates.",
    how = "Picks the fastest up-to-date mirrors and refreshes the package lists.",
    check = [==[grep -E '^Server' /etc/pacman.d/mirrorlist | head -n 5]==],
    fix = [==[sudo pacman-mirrors --fasttrack 5 && sudo pacman -Syyu]==],
    arch_fix = [==[sudo reflector --latest 10 --protocol https --sort rate --save /etc/pacman.d/mirrorlist && sudo pacman -Syyu]==],
  },
  {
    title = "Full system update",
    topic = "Packages",
    keywords = "upgrade update syu outdated",
    when = "Before asking on the forum: many problems are fixed by updates.",
    how = "Arch and Manjaro only support fully updated systems.",
    check = [==[checkupdates 2>/dev/null | wc -l | xargs echo 'packages waiting:']==],
    fix = [==[sudo pacman -Syu]==],
  },
  {
    title = "No sound",
    topic = "Sound",
    keywords = "audio speakers headphones silent pipewire volume mute",
    when = "Speakers or headphones are silent, or devices are missing in the volume menu.",
    how = "Restarts the sound server (PipeWire) for your user.",
    check = [==[wpctl status | sed -n '/Sinks:/,/Sources:/p']==],
    fix = [==[systemctl --user restart pipewire pipewire-pulse wireplumber && echo 'sound server restarted']==],
  },
  {
    title = "Wi-Fi or network gone",
    topic = "Network",
    keywords = "wifi wlan internet no connection networkmanager dns offline",
    when = "No networks listed, or connected but no internet.",
    how = "Unblocks the radio switch and restarts NetworkManager.",
    check = [==[rfkill list; nmcli device status]==],
    fix = [==[rfkill unblock all; sudo systemctl restart NetworkManager && sleep 3 && nmcli device status]==],
  },
  {
    title = "Bluetooth will not turn on",
    topic = "Network",
    keywords = "bluetooth adapter rfkill headset mouse pairing",
    when = "The Bluetooth switch does nothing or no adapter is found.",
    how = "Unblocks the radio, enables the Bluetooth service at boot and restarts it.",
    check = [==[rfkill list bluetooth; systemctl is-active bluetooth]==],
    fix = [==[rfkill unblock bluetooth; sudo systemctl enable --now bluetooth && sudo systemctl restart bluetooth && bluetoothctl show | head -n 5]==],
  },
  {
    title = "Disk is full",
    topic = "System",
    keywords = "space storage cache journal full pacman cache",
    when = "Updates fail with not enough free disk space, or the system feels stuck.",
    how = "Keeps the 2 newest versions of each cached package, deletes cached files of uninstalled packages and shrinks the system log to 200 MB. Needs pacman-contrib.",
    check = [==[df -h / /home | uniq; du -sh /var/cache/pacman/pkg 2>/dev/null; journalctl --disk-usage]==],
    fix = [==[sudo paccache -rk2 && sudo paccache -ruk0 && sudo journalctl --vacuum-size=200M && df -h /]==],
  },
  {
    title = "Remove orphan packages",
    topic = "Packages",
    keywords = "unused dependencies cleanup leftover",
    when = "Leftover dependencies nothing uses any more.",
    how = "pacman shows the list and asks before removing.",
    check = [==[pacman -Qdtq || echo 'no orphans']==],
    fix = [==[pacman -Qdtq | sudo pacman -Rns -]==],
  },
  {
    title = "Merge .pacnew config files",
    topic = "Packages",
    keywords = "pacnew pacsave config merge pacdiff etc",
    when = "Updates left new versions of config files that were never merged.",
    how = "Opens pacdiff to view, merge or remove each one.",
    check = [==[find /etc -name '*.pacnew' 2>/dev/null || true]==],
    fix = [==[sudo DIFFPROG='diff --color -u' pacdiff]==],
  },
  {
    title = "Noctalia bar or panels look wrong",
    topic = "Noctalia",
    keywords = "bar widgets colours theme config reload panels",
    when = "Widgets missing, wrong colours, or settings changes not applied.",
    how = "Checks the Noctalia config and reloads it without logging out.",
    check = [==[noctalia config validate]==],
    fix = [==[noctalia config validate && noctalia msg config-reload && echo 'Noctalia config reloaded']==],
  },
  {
    title = "Noctalia bar frozen or gone",
    topic = "Noctalia",
    keywords = "bar missing frozen crashed restart launcher unresponsive",
    when = "The bar, panels or launcher stopped responding or disappeared.",
    how = "Stops Noctalia, waits until it has exited, then starts it again.",
    check = [==[pgrep -a -x noctalia || echo 'Noctalia is not running']==],
    fix = [==[pkill -x noctalia; while pgrep -x noctalia >/dev/null; do sleep 0.1; done; setsid -f noctalia -d >/dev/null 2>&1; sleep 1; pgrep -a -x noctalia && echo 'Noctalia restarted']==],
  },
  {
    title = "Graphics driver check (Manjaro)",
    topic = "System",
    keywords = "gpu nvidia amd intel mhwd black screen resolution games slow",
    when = "Black screen, low resolution or games running slowly.",
    how = "Lists installed and available drivers. The fix installs the proprietary (nonfree) driver, which is meant for NVIDIA; on AMD or Intel it fails or does nothing useful.",
    check = [==[mhwd -li; echo; mhwd -l]==],
    fix = [==[sudo mhwd -a pci nonfree 0300]==],
    arch_fix = [==[echo 'On plain Arch, install the driver package for your GPU (mesa, vulkan-radeon, nvidia-open).']==],
  },
  {
    title = "Clear old failed-service warnings",
    topic = "System",
    keywords = "systemd failed units reset-failed polkit services",
    when = "Failed services are listed that you already fixed, or leftovers like polkit-agent-helper@.",
    how = "Forgets the failed state of all services. Broken ones fail again on the next start.",
    check = [==[systemctl --failed --no-pager; systemctl --user --failed --no-pager]==],
    fix = [==[sudo systemctl reset-failed; systemctl --user reset-failed; systemctl --failed --no-pager]==],
  },
  {
    title = "Audit rules fail to load (audit-rules.service)",
    topic = "System",
    keywords = "audit auditd rules failed service",
    when = "audit-rules.service is listed as failed.",
    how = "Reloads the audit rules from /etc/audit/audit.rules and shows the error and whether audit is locked (enabled 2 = locked until reboot).",
    check = [==[systemctl status audit-rules --no-pager -n 15; ls /etc/audit/rules.d/]==],
    fix = [==[sudo auditctl -R /etc/audit/audit.rules; echo; sudo auditctl -s; echo; ls /etc/audit/rules.d/]==],
  },
  {
    title = "Microphone is silent or muted",
    topic = "Sound",
    keywords = "mic input recording capture source meeting voice",
    when = "Apps hear nothing from the microphone, or the input level stays at zero.",
    how = "Unmutes the default input and sets it to 100%. Pick the right device in the volume control if it stays silent.",
    check = [==[wpctl get-volume @DEFAULT_AUDIO_SOURCE@; wpctl status | sed -n '/Sources:/,/Filters:/p']==],
    fix = [==[wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 && wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1.0 && wpctl get-volume @DEFAULT_AUDIO_SOURCE@]==],
  },
  {
    title = "Bluetooth audio connected but silent or poor",
    topic = "Sound",
    keywords = "headphones headset speaker a2dp profile earbuds bluetooth sound crackling",
    when = "The device is connected, but there is no sound, or it sounds like a phone call.",
    how = "Restarts the audio session manager (WirePlumber). Then pick the A2DP profile for the device in the volume control.",
    check = [==[noctalia msg bluetooth-status; wpctl status | sed -n '/Sinks:/,/Sources:/p']==],
    fix = [==[systemctl --user restart wireplumber && echo 'WirePlumber restarted. Open the volume control and set the A2DP profile.']==],
  },
  {
    title = "Screen layout lost after resume or plugging a monitor",
    topic = "Display",
    keywords = "monitor screen resolution position hdmi displayport kanshi wlr-randr dual wrong output",
    when = "Monitors are in the wrong place, mirrored, off, or a screen stays black after waking up.",
    how = "Restarts kanshi, which applies your saved monitor profile, and lists the outputs.",
    check = [==[wlr-randr; pgrep -a -x kanshi || echo 'kanshi is not running']==],
    fix = [==[pkill -x kanshi; setsid -f kanshi >/dev/null 2>&1; sleep 2; wlr-randr]==],
  },
  {
    title = "Wrong resolution or refresh rate",
    topic = "Display",
    keywords = "hz fps mode scale blurry 60 144 monitor modes",
    when = "A monitor runs at a low resolution, or not at its best refresh rate.",
    how = "Lists the modes of every output. Set one with wlr-randr, then save it in ~/.config/kanshi/config so it stays.",
    check = [==[wlr-randr]==],
    fix = [==[wlr-randr; echo; echo 'Set a mode: wlr-randr --output NAME --mode WIDTHxHEIGHT@HZ'; echo 'Keep it: put the same values in ~/.config/kanshi/config and restart kanshi.']==],
  },
  {
    title = "Screen stays dark after the idle dim",
    topic = "Display",
    keywords = "black dim ddc blank wake lock screen off monitor backlight",
    when = "The screen was dimmed or blanked by idle and does not come back.",
    how = "Runs mb-screen-on, which removes the dim layer and wakes the monitors.",
    check = [==[command -v mb-screen-on || echo 'mb-screen-on is not installed'; ls /dev/i2c-* 2>&1 | head -n 5]==],
    fix = [==[mb-screen-on && echo 'screens restored']==],
  },
  {
    title = "Wi-Fi connected but no internet or DNS fails",
    topic = "Network",
    keywords = "dns resolve name resolution website not loading ping internet offline vpn",
    when = "The network shows connected, but sites do not open, or names do not resolve.",
    how = "Flushes the DNS cache and restarts NetworkManager. Active connections (VPN, downloads) drop for a moment.",
    check = [==[ping -c 2 -W 2 1.1.1.1; resolvectl query archlinux.org 2>&1 | head -n 4]==],
    fix = [==[sudo resolvectl flush-caches 2>/dev/null; sudo systemctl restart NetworkManager && sleep 3 && nmcli general status]==],
  },
  {
    title = "Clock or date is wrong",
    topic = "System",
    keywords = "time timezone ntp sync hour date calendar certificate",
    when = "The time is off, or secure sites and updates fail because of the date.",
    how = "Turns network time synchronization on.",
    check = [==[timedatectl]==],
    fix = [==[sudo timedatectl set-ntp true && sleep 2 && timedatectl]==],
  },
  {
    title = "Printer not found",
    topic = "System",
    keywords = "print cups scanner network printer avahi driver",
    when = "A printer does not show up, or printing does nothing.",
    how = "Installs CUPS and avahi if they are missing, then enables and starts them.",
    check = [==[systemctl is-active cups avahi-daemon]==],
    fix = [==[sudo pacman -S --needed cups avahi nss-mdns && sudo systemctl enable --now cups avahi-daemon && echo 'CUPS and avahi are running. Add the printer with system-config-printer.']==],
  },
  {
    title = "Flatpak apps will not update or start",
    topic = "Packages",
    keywords = "flatpak runtime flathub repair sandbox app store",
    when = "Flatpak reports a missing runtime or a broken installation.",
    how = "Repairs the system and user installations, then updates.",
    check = [==[command -v flatpak >/dev/null && flatpak list --app | head -n 20 || echo 'flatpak is not installed']==],
    fix = [==[sudo flatpak repair; flatpak repair --user; flatpak update]==],
  },
  {
    title = "AUR package fails to build",
    topic = "Packages",
    keywords = "aur makepkg yay paru build compile base-devel git helper",
    when = "An AUR package stops with a build error, or the helper cannot compile.",
    how = "Installs the build tools (base-devel, git). Read the error above it for the real cause.",
    check = [==[pacman -Q base-devel git 2>&1; df -h /tmp | tail -n 1]==],
    fix = [==[sudo pacman -S --needed base-devel git]==],
  },
  {
    title = "Fonts or emoji show empty squares",
    topic = "System",
    keywords = "font emoji glyph missing boxes tofu noto icons",
    when = "Text or emoji appear as boxes or question marks.",
    how = "Installs the Noto fonts with emoji and rebuilds the font cache.",
    check = [==[fc-list | grep -ci emoji | xargs echo 'emoji fonts:']==],
    fix = [==[sudo pacman -S --needed noto-fonts noto-fonts-emoji && fc-cache -f && echo 'font cache rebuilt']==],
  },
  {
    title = "USB drive will not mount or is read-only",
    topic = "System",
    keywords = "usb disk external drive mount readonly fsck ntfs exfat sd card",
    when = "A drive does not appear, cannot be written to, or says the file system is dirty.",
    how = "Shows the drives and the latest kernel messages. Repair is up to you: unmount first, then check the partition. Never check a mounted one.",
    check = [==[lsblk -f; journalctl -k -n 15 --no-pager]==],
    fix = [==[lsblk -f; echo; echo 'Unmount the partition, then: sudo fsck /dev/sdXN (replace sdXN). NTFS: sudo ntfsfix /dev/sdXN']==],
  },
  {
    title = "Still the old kernel after an update",
    topic = "System",
    keywords = "kernel grub boot menu linux version mhwd-kernel bootloader",
    when = "The system starts an older kernel than the one installed, or the boot menu misses an entry.",
    how = "Shows the running and installed kernels, then rebuilds the boot menu.",
    check = [==[uname -r; mhwd-kernel -li 2>/dev/null || pacman -Q | grep -E '^linux[0-9]* ']==],
    fix = [==[ -d /boot/grub ] || { echo 'No GRUB found: update your bootloader by hand.'; exit 1; }; sudo update-grub]==],
    arch_fix = [==[ -d /boot/grub ] || { echo 'No GRUB found: update your bootloader by hand.'; exit 1; }; sudo grub-mkconfig -o /boot/grub/grub.cfg]==],
  },
  {
    title = "Hotkeys do nothing after a config edit",
    topic = "Noctalia",
    keywords = "keybind shortcut rc.xml labwc reconfigure keys broken xml",
    when = "Shortcuts stopped working after editing rc.xml, or a change has no effect.",
    how = "Checks rc.xml for XML errors, then makes labwc read it again.",
    check = [==[command -v xmllint >/dev/null || { echo 'xmllint is missing (libxml2)'; exit 1; }; xmllint --noout ~/.config/mabox-noctalia-ce/rc.xml && echo 'rc.xml is valid']==],
    fix = [==[xmllint --noout ~/.config/mabox-noctalia-ce/rc.xml && labwc --reconfigure && echo 'labwc reloaded']==],
  },
  {
    title = "Bar, dock or theme is messed up (reset to defaults)",
    topic = "Noctalia",
    keywords = "reset default look widgets bar dock colours theme broken settings restore",
    when = "The look is broken beyond the reload fix, and you want the shipped defaults back.",
    how = "Resets the Noctalia bar, dock, widgets and theme to the defaults. Each file keeps a backup copy (.bak-DATE). Your own themerc-override stays.",
    check = [==[mb-reset-wl]==],
    fix = [==[mb-reset-wl noctalia]==],
  },
  {
    title = "A plugin does not load",
    topic = "Noctalia",
    keywords = "plugin mabox panel missing disabled failed reload enable widget",
    when = "A panel or widget from a Mabox plugin is missing, or says it failed.",
    how = "Lists the enabled plugins, then switches each one off and on again.",
    check = [==[noctalia msg plugins list | grep ' enabled']==],
    fix = [==[noctalia msg plugins list | awk '$4 == "enabled" { print $1 }' | while read -r id; do noctalia msg plugins disable "$id" </dev/null >/dev/null; noctalia msg plugins enable "$id" </dev/null >/dev/null; echo "reloaded $id"; done]==],
  },
  {
    title = "Settings or new defaults were not applied after an update",
    topic = "Noctalia",
    keywords = "mb-migrate migration config version defaults update new keys autostart",
    when = "An update added a key or setting you do not have.",
    how = "Runs the pending config migrations once. It only changes what an update needs; your own settings stay.",
    check = [==[echo "applied: $(cat "${XDG_STATE_HOME:-$HOME/.local/state}/mabox-noctalia-ce/config-version" 2>/dev/null || echo 0), available: $(grep -c '^migrate_' "$(command -v mb-migrate)")"]==],
    fix = [==[mb-migrate && echo 'migrations done']==],
  },
  {
    title = "Notifications do not show up",
    topic = "Noctalia",
    keywords = "notification popup toast dunst mako swaync daemon notify-send",
    when = "notify-send and apps show nothing, or the notification area stays empty.",
    how = "Another notification daemon can hold the name Noctalia needs. This stops the usual ones (dunst, mako, swaync).",
    check = [==[pgrep -a -x 'dunst|mako|swaync' || echo 'no other notification daemon running'; notify-send 'Fixes' 'test notification']==],
    fix = [==[pkill -x dunst; pkill -x mako; pkill -x swaync; sleep 1; notify-send 'Fixes' 'test notification' && echo 'test sent']==],
  },
}
