<openbox_menu>
<!-- Note: for localization support of menu items "client-menu" has to be removed here -->
<menu id="client-menu">
  <item label="Minimize">
    <action name="Iconify" />
  </item>
  <item label="Maximize">
    <action name="ToggleMaximize" />
  </item>
  <item label="Fullscreen">
    <action name="ToggleFullscreen" />
  </item>
  <item label="Roll Up/Down">
    <action name="ToggleShade" />
  </item>
  <item label="Decorations">
    <action name="ToggleDecorations" />
  </item>
  <item label="Always on Top">
    <action name="ToggleAlwaysOnTop" />
  </item>
  <!--
    Any menu with the id "workspaces" will be hidden
    if there is only a single workspace available.
  -->
  <menu id="client-send-to-menu" />
  <!--
    openbox default workspace selector
    to use replace above workspace menu with the example below
    the label is required, but you can change the text.

    <menu id="client-send-to-menu" label="Send to..." />
  -->
  <item label="Close">
    <action name="Close" />
  </item>
</menu>

<menu id="root-menu">
  <separator label="Favorites" />
  <item label="Terminal">
    <action name="Execute" command="exo-open --launch TerminalEmulator" />
  </item>
  <item label="WWW Browser">
    <action name="Execute" command="exo-open --launch WebBrowser" />
  </item>
  <item label="File Manager">
    <action name="Execute" command="exo-open --launch FileManager" />
  </item>
  <item label="Add/Remove software">
    <action name="Execute" command="pamac-manager" />
  </item>
  <item label="Launcher">
    <action name="Execute" command="noctalia msg panel-toggle launcher" />
  </item>
  <menu id="settings-menu" label="Mabox Config">
    <item label="Mabox Control Center">
      <action name="Execute" command="mcc" />
    </item>
    <item label="Noctalia settings">
      <action name="Execute" command="noctalia msg settings-toggle" />
    </item>
    <item label="Control center">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </item>
    <item label="Wallpaper">
      <action name="Execute" command="noctalia msg panel-toggle wallpaper" />
    </item>
    <item label="Conky manager">
      <action name="Execute" command="~/.config/mabox-noctalia-ce/menuscripts/conky-manager" />
    </item>
    <item label="Preferred applications">
      <action name="Execute" command="exo-preferred-applications" />
    </item>
    <separator />
    <item label="Edit rc.xml">
      <action name="Execute" command="geany ~/.config/mabox-noctalia-ce/rc.xml" />
    </item>
    <item label="Edit menu.xml">
      <action name="Execute" command="geany ~/.config/mabox-noctalia-ce/menu.xml" />
    </item>
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
  </menu>
  <menu id="apps-menu" label="Applications" execute="labwc-menu-generator -p" />
  <menu id="client-list-combined-menu" label="Running..." />
  <separator />
  <item label="Screenshot">
    <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/screenshots &amp;&amp; grim ~/Pictures/screenshots/$(date +%F_%H-%M-%S).png'" />
  </item>
  <item label="Lock screen">
    <action name="Execute" command="swaylock -f" />
  </item>
  <item label="Session menu">
    <action name="Execute" command="noctalia msg panel-toggle session" />
  </item>
  <item label="Exit">
    <action name="Exit" />
  </item>
</menu>

</openbox_menu>
