<openbox_menu>
<!-- Note: for localization support of menu items "client-menu" has to be removed here -->
<menu id="client-menu">
  <item label="Minimize">
    <action name="Iconify" />
  </item>
  <item label="Maximize">
    <action name="ToggleMaximize" />
  </item>
  <item label="Fullscreen">
    <action name="ToggleFullscreen" />
  </item>
  <item label="Roll Up/Down">
    <action name="ToggleShade" />
  </item>
  <item label="Decorations">
    <action name="ToggleDecorations" />
  </item>
  <item label="Always on Top">
    <action name="ToggleAlwaysOnTop" />
  </item>
  <!--
    Any menu with the id "workspaces" will be hidden
    if there is only a single workspace available.
  -->
  <menu id="client-send-to-menu" />
  <!--
    openbox default workspace selector
    to use replace above workspace menu with the example below
    the label is required, but you can change the text.

    <menu id="client-send-to-menu" label="Send to..." />
  -->
  <item label="Close">
    <action name="Close" />
  </item>
</menu>

<menu id="root-menu">
  <separator label="Favorites" />
  <item label="Terminal" icon="utilities-terminal">
    <action name="Execute" command="exo-open --launch TerminalEmulator" />
  </item>
  <item label="WWW Browser" icon="web-browser">
    <action name="Execute" command="exo-open --launch WebBrowser" />
  </item>
  <item label="File Manager" icon="system-file-manager">
    <action name="Execute" command="pcmanfm" />
  </item>
  <separator />
  <item label="Launcher" icon="applications-all">
    <action name="Execute" command="noctalia msg panel-toggle launcher" />
  </item>
  <separator />
  <menu id="settings-menu" label="Mabox noctalia ce" icon="preferences-system">
    <item label="Noctalia settings" icon="preferences-system">
      <action name="Execute" command="noctalia msg settings-toggle" />
    </item>
    <item label="Control center" icon="preferences-desktop-display">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </item>
    <item label="Add/Remove software" icon="system-software-install">
      <action name="Execute" command="pamac-manager" />
    </item>
    <item label="Snapshot" icon="media-optical">
      <action name="Execute" command="noctalia msg panel-toggle mabox/snapshot:main" />
    </item>
    <separator />
    <item label="Wallpaper" icon="preferences-desktop-wallpaper">
      <action name="Execute" command="noctalia msg panel-toggle wallpaper" />
    </item>
    <item label="Wallpaper folders" icon="preferences-desktop-wallpaper">
      <action name="Execute" command="noctalia msg panel-toggle mabox/wallpaper-dirs:dirs" />
    </item>
    <item label="Look and Feel" icon="gtk-theme-config.svg">
      <action name="Execute" command="nwg-look" />
    </item>
    <separator />
    <item label="Config files" icon="document-properties">
      <action name="Execute" command="noctalia msg panel-toggle mabox/configs:main" />
    </item>
    <item label="Config files pinned" icon="document-properties">
      <action name="Execute" command="mb-pinned configs" />
    </item>
    <item label="Reset configs" icon="edit-undo">
      <action name="Execute" command="noctalia msg panel-toggle mabox/reset:main" />
    </item>
    <separator />
    <item label="Edit autostart" icon="edit">
      <action name="Execute" command="xdg-open ~/.config/mabox-noctalia-ce/autostart" />
    </item>
    <item label="Reconfigure" icon="view-refresh">
      <action name="Reconfigure" />
    </item>
  </menu>
  <menu id="tools-menu" label="Tools noctalia ce" icon="applications-utilities">
    <item label="Colors" icon="applications-graphics">
      <action name="Execute" command="noctalia msg panel-toggle mabox/colors:picker" />
    </item>
    <item label="Colors pinned" icon="applications-graphics">
      <action name="Execute" command="mb-pinned colors" />
    </item>
    <separator />
    <item label="Places" icon="folder">
      <action name="Execute" command="noctalia msg panel-toggle mabox/places:main" />
    </item>
    <item label="Places pinned" icon="folder">
      <action name="Execute" command="mb-pinned places" />
    </item>
    <separator />
    <item label="Notes" icon="accessories-text-editor">
      <action name="Execute" command="noctalia msg panel-toggle mabox/notes:main" />
    </item>
    <item label="Notes pinned" icon="accessories-text-editor">
      <action name="Execute" command="mb-pinned notes" />
    </item>
    <separator />
    <item label="Status" icon="utilities-system-monitor">
      <action name="Execute" command="noctalia msg panel-toggle mabox/status:main" />
    </item>
    <item label="Status pinned" icon="utilities-system-monitor">
      <action name="Execute" command="mb-pinned status" />
    </item>
    <separator />
    <item label="Keys" icon="input-keyboard">
      <action name="Execute" command="noctalia msg panel-toggle mabox/keys:keys" />
    </item>
    <item label="Cava" icon="audio-x-generic">
      <action name="Execute" command="mb-cava toggle" />
    </item>
    <item label="Cava settings" icon="preferences-other">
      <action name="Execute" command="noctalia msg panel-toggle mabox/cava:main" />
    </item>
    <item label="Equalizer" icon="multimedia-volume-control">
      <action name="Execute" command="noctalia msg panel-toggle mabox/equalizer:main" />
    </item>
    <item label="System info" icon="computer">
      <action name="Execute" command="noctalia msg panel-toggle mabox/system:system" />
    </item>
    <separator />
    <item label="Music" icon="multimedia-audio-player">
      <action name="Execute" command="noctalia msg panel-open launcher /music" />
    </item>
    <item label="Play stream URL" icon="media-playback-start">
      <action name="Execute" command="mpv-play-stream" />
    </item>
    <item label="Add music URL" icon="list-add">
      <action name="Execute" command="noctalia msg panel-open mabox/music:add" />
    </item>
  </menu>
  <menu id="apps-menu" label="Applications" icon="applications-other" execute="labwc-menu-generator -p -I" />
  <menu id="client-list-combined-menu" label="Running..." icon="window-duplicate" />
  <separator />
  <menu id="screenshot-menu" label="Screenshot" icon="accessories-screenshot">
    <item label="Screen">
      <action name="Execute" command="mb-screenshot screenshot-fullscreen" />
    </item>
    <item label="All screens">
      <action name="Execute" command="mb-screenshot screenshot-fullscreen all" />
    </item>
    <item label="Pick a screen">
      <action name="Execute" command="mb-screenshot screenshot-fullscreen pick" />
    </item>
    <item label="Window">
      <action name="Execute" command="mb-screenshot screenshot-window" />
    </item>
    <item label="Select area">
      <action name="Execute" command="mb-screenshot screenshot-region" />
    </item>
    <item label="Annotate">
      <action name="Execute" command="noctalia msg screenshot-annotate" />
    </item>
    <separator />
    <menu id="shot-delay-screen" label="Screen after..." execute="mb-screenshot-menu screenshot-fullscreen" />
    <menu id="shot-delay-area" label="Select area, shot after..." execute="mb-screenshot-menu screenshot-region" />
  </menu>
  <menu id="record-menu" label="Screen recording" icon="media-record">
    <item label="Record region / stop">
      <action name="Execute" command="screenrec-toggle" />
    </item>
    <item label="Open recordings folder" icon="folder-videos">
      <action name="Execute" command="sh -c 'mkdir -p ~/Videos/Recordings &amp;&amp; xdg-open ~/Videos/Recordings'" />
    </item>
  </menu>
  <menu id="convert-menu" label="Converter" icon="applications-multimedia">
    <menu id="convert-video" label="Video">
      <item label="MP4 (H.264)">
        <action name="Execute" command="mb-convert mp4" />
      </item>
      <item label="MP4 (H.265)">
        <action name="Execute" command="mb-convert hevc" />
      </item>
      <item label="WebM (VP9)">
        <action name="Execute" command="mb-convert webm" />
      </item>
      <item label="MKV (AV1)">
        <action name="Execute" command="mb-convert av1" />
      </item>
      <separator />
      <item label="MKV to MP4 (remux, no re-encode)">
        <action name="Execute" command="mb-convert mp4-remux" />
      </item>
      <item label="MP4 to MKV (remux, no re-encode)">
        <action name="Execute" command="mb-convert mkv-remux" />
      </item>
    </menu>
    <menu id="convert-gif" label="Video to GIF">
      <item label="Low (10 fps, 480 px)">
        <action name="Execute" command="mb-convert gif-low" />
      </item>
      <item label="Medium (15 fps, 720 px)">
        <action name="Execute" command="mb-convert gif-medium" />
      </item>
      <item label="High (20 fps, 1080 px)">
        <action name="Execute" command="mb-convert gif-high" />
      </item>
    </menu>
    <menu id="convert-audio" label="Audio / extract audio">
      <item label="MP3">
        <action name="Execute" command="mb-convert mp3" />
      </item>
      <item label="Opus">
        <action name="Execute" command="mb-convert opus" />
      </item>
      <item label="Ogg Vorbis">
        <action name="Execute" command="mb-convert ogg" />
      </item>
      <item label="AAC (m4a)">
        <action name="Execute" command="mb-convert m4a" />
      </item>
      <item label="FLAC">
        <action name="Execute" command="mb-convert flac" />
      </item>
      <item label="WAV">
        <action name="Execute" command="mb-convert wav" />
      </item>
    </menu>
    <menu id="convert-image" label="Image">
      <item label="PNG">
        <action name="Execute" command="mb-convert png" />
      </item>
      <item label="JPG">
        <action name="Execute" command="mb-convert jpg" />
      </item>
      <item label="WebP">
        <action name="Execute" command="mb-convert webp" />
      </item>
      <item label="AVIF">
        <action name="Execute" command="mb-convert avif" />
      </item>
    </menu>
  </menu>
  <separator />
  <item label="Lock screen" icon="system-lock-screen">
    <action name="Execute" command="noctalia msg session lock" />
  </item>
  <item label="Session menu" icon="system-shutdown">
    <action name="Execute" command="noctalia msg panel-toggle session" />
  </item>
  <item label="Exit" icon="application-exit">
    <action name="Exit" />
  </item>
</menu>

</openbox_menu>
